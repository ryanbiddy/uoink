+                                 if k in spk and isinstance(spk[k], str)}
+                    clean_speakers.append(clean_spk)
+            filtered["speakers"] = clean_speakers
+        elif isinstance(raw_speakers, dict):
+            filtered["speakers"] = {str(k): v for k, v in raw_speakers.items()
+                                    if isinstance(k, (str, int))}
+
+        raw_diar = data.get("diarization")
+        if isinstance(raw_diar, dict):
+            clean_diar = {}
+            if "speakers" in raw_diar:
+                spk = raw_diar["speakers"]
