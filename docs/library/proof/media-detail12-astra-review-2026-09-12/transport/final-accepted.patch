+
+def _run_node_dashboard(payload: dict) -> dict:
+    res = subprocess.run(
+        ["node", "-e", NODE_DASHBOARD_HARNESS],
+        input=json.dumps(payload),
+        cwd=ROOT,
+        text=True,
+        capture_output=True,
+        timeout=15,
+    )
+    assert res.returncode == 0, f"Node failed (code {res.returncode}): {res.stderr}"
+    return json.loads(res.stdout)
