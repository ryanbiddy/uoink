+class _CountedNativeHandle:
+    """CloseHandle only after every user drops the handle."""
+
+    def __init__(self, *, owns_close: bool = True) -> None:
+        self._guard = threading.Lock()
+        self.handle = None
+        self._users = 0
+        self._close_requested = False
+        self.owns_close = bool(owns_close)
+
+    def set_handle(self, handle) -> None:
+        with self._guard:
+            self.handle = handle
+            self._users = 0
+            self._close_requested = False
+
+    def acquire(self):
+        with self._guard:
+            if self._close_requested or self.handle is None:
+                return None
+            self._users += 1
+            return self.handle
+
+    def release(self) -> None:
+        close_now = None
+        with self._guard:
+            if self._users > 0:
+                self._users -= 1
+            if self._users == 0 and self._close_requested:
+                close_now = self.handle
+                self.handle = None
+                self._close_requested = False
+        if close_now is not None and self.owns_close:
+            _win_close_handle(close_now)
+
+    def request_close(self) -> None:
+        close_now = None
+        with self._guard:
+            self._close_requested = True
+            if self._users == 0:
+                close_now = self.handle
+                self.handle = None
+                self._close_requested = False
+        if close_now is not None and self.owns_close:
+            _win_close_handle(close_now)
+
+    @property
+    def in_use(self) -> bool:
+        with self._guard:
+            return self._users > 0
+
