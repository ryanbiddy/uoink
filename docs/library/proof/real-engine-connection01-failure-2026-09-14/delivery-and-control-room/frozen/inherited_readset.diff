+def validate_admitted_manifest(payload, selected_model, control_value, expected_manifest_sha256, root=None):
+    """Validate the authenticated passive message against the selected Model before handle calls."""
+    _require(type(payload) is dict and set(payload) == {"schema", "choice", "manifest_sha256", "namespace_sha256", "members"},
+             "adoption_manifest_shape")
+    _require(payload["schema"] == ADMITTED_FORMAT, "admitted_adoption_schema")
+    _require(selected_model is not None and hasattr(selected_model, "choice") and hasattr(selected_model, "assets"),
+             "selected_model_required")
+    _require(payload["choice"] == selected_model.choice, "admitted_model_choice_mismatch")
+    _require(type(payload["manifest_sha256"]) is str and payload["manifest_sha256"] == expected_manifest_sha256,
+             "authenticated_manifest_binding")
+    rows = payload["members"]
+    _require(type(rows) is list and len(rows) == len(selected_model.assets) and len(rows) in (4, 5),
+             "member_count_mismatch")
+    _require(type(control_value) is int and 0 < control_value < (1 << 64) - 1, "fixed_control_handle")
+    values = set()
+    validated = []
+    seen_names = []
+    for index, (asset, row) in enumerate(zip(selected_model.assets, rows, strict=True)):
+        _require(type(row) is dict and set(row) == {"name", "handle", "identity", "sha256"}, "member_shape")
+        name, value, identity = row["name"], row["handle"], row["identity"]
+        _require(type(name) is str and name == asset.name and name not in seen_names, "member_order_and_name")
+        seen_names.append(name)
+        _require(type(value) is int and 0 < value < (1 << 64) - 1 and value != control_value
+                 and value not in values, "unique_inherited_file_handle")
+        values.add(value)
+        _require(type(row["sha256"]) is str and row["sha256"] == asset.sha256, "member_digest_mismatch")
+        _require(type(identity) is dict and set(identity) == {"final_path", "volume_serial", "file_id", "size", "links", "directory"},
+                 "complete_file_identity")
+        final_path = identity["final_path"]
+        _require(type(final_path) is str and len(final_path) <= 4096, "final_path_bound")
+        if root is not None:
+            _require(final_path.casefold() == ("\\\\?\\" + root + "\\" + name).casefold(), "final_path_mismatch")
+        _require(type(identity["volume_serial"]) is int and 0 <= identity["volume_serial"] < 1 << 64,
+                 "volume_serial_bound")
+        file_id = identity["file_id"]
+        _require(type(file_id) is str and len(file_id) == 32 and all(char in "0123456789abcdef" for char in file_id),
+                 "file_id_shape")
+        _require(type(identity["size"]) is int and identity["size"] == asset.size
+                 and type(identity["links"]) is int and identity["links"] == 1
+                 and identity["directory"] is False, "file_identity_shape")
+        expected = FileIdentity(final_path, identity["volume_serial"], bytes.fromhex(file_id),
+                                identity["size"], 1, False)
+        validated.append((name, value, expected, row["sha256"], asset.size))
+    binding = [[asset.name, asset.size, asset.sha256] for asset in sorted(selected_model.assets, key=lambda item: item.name)]
+    expected_ns_sha = hashlib.sha256(json.dumps(binding, separators=(",", ":")).encode("ascii")).hexdigest()
+    _require(type(payload["namespace_sha256"]) is str and payload["namespace_sha256"] == expected_ns_sha,
+             "admitted_namespace_digest_mismatch")
+    return tuple(validated)
+
