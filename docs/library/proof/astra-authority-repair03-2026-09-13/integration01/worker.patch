+def _native_handle_liveness(handle, created_ms: int | None) -> str:
+    if handle is None:
+        return "unknown"
+    from ctypes import wintypes
+    code = wintypes.DWORD()
+    if not _kernel32().GetExitCodeProcess(handle, ctypes.byref(code)):
+        return "unknown"
