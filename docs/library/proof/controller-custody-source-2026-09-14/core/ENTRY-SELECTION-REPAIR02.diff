+            self._starts[permit] = worker
+            manager._reservations.bind_worker(token, worker)
+            # No import or journal work under these state locks.
+            with manager._lock:
+                with token._lock:
+                    if (_require_factory_start is not attempt.factory_check
+                            or _FIXED_FACTORY_START_CHECK is not attempt.factory_check):
