"""Documentary preparation only; never imports or runs the candidate."""
from pathlib import Path
import hashlib
import json

BASE = Path(r"E:\AI\projects\uoink\checkouts\Yoink-library")
AUTHOR = BASE / "_scratch/asr-worker-namespace-proposal01"
DEST = BASE / "_scratch/astra-worker-namespace-qualification01"
SEAL = "412ff1c34376f0ce156c055e27afc66e9d19ed3ed7358f939e7f8df1b526f02f"


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def read(path):
    with path.open("rb") as stream:
        raw = stream.read(1048577)
    assert len(raw) <= 1048576
    return raw


seal_raw = read(AUTHOR / "MANIFEST.json")
assert digest(seal_raw) == SEAL
seal = json.loads(seal_raw)
assert seal["payload_count"] == len(seal["files"]) == 37
for item in seal["files"]:
    relative = Path(item["path"])
    assert not relative.is_absolute() and ".." not in relative.parts
    raw = read(AUTHOR / relative)
    assert len(raw) == item["bytes"] and digest(raw) == item["sha256"]
admission = json.loads(read(AUTHOR / "ROOT-ADMISSION.json"))
run = AUTHOR / "runs/nsp01"
result = json.loads(read(run / "stdout.json"))
exit_receipt = json.loads(read(run / "exit.json"))
assert result["count"] == result["passed"] == 54 and result["failed"] == result["skipped"] == 0
assert result["guard_valid"] is True and exit_receipt["receipt_valid"] is True
assert exit_receipt["inputs_unchanged"] is True and exit_receipt["native_exit"] == exit_receipt["outer_exit"] == 0
assert [row["name"] for row in result["cases"]] == admission["expected_cases"]
assert all(row["passed"] is True for row in result["cases"])
assert json.loads(read(run / "ACTUAL-OUTER-TOOL.json"))["exit_code"] == 0
names = tuple(admission["input_sha256"])
assert len(names) == 9 and not DEST.exists()
prepared = []
payloads = {}
for name in names:
    assert Path(name).name == name
    raw = read(AUTHOR / name)
    assert digest(raw) == admission["input_sha256"][name]
    changed = raw
    if name == "run_namespace01.ps1":
        old, new = str(AUTHOR).encode(), str(DEST).encode()
        assert raw.count(old) == 1
        changed = raw.replace(old, new)
    payloads[name] = changed
    prepared.append({"name": name, "author_sha256": digest(raw), "root_sha256": digest(changed),
                     "only_launcher_literal_path_changed": name == "run_namespace01.ps1"})
DEST.mkdir()
for name, raw in payloads.items():
    with (DEST / name).open("xb") as stream:
        stream.write(raw)
root_admission = {"root_reviewed": False, "scope": admission["scope"], "label": "nsp01",
                  "input_sha256": {row["name"]: row["root_sha256"] for row in prepared},
                  "expected_cases": admission["expected_cases"]}
for name, value in (("ADMISSION-TEMPLATE.json", root_admission),
                    ("ROOT-COPY-BINDINGS.json", {"author_preparation_manifest_sha256": SEAL, "files": prepared,
                                               "candidate_executed_by_preparer": False})):
    with (DEST / name).open("xb") as stream:
        stream.write((json.dumps(value, indent=2) + "\n").encode())
print(json.dumps({"destination": str(DEST), "copied_inputs": len(prepared), "candidate_executed": False,
                  "launcher_sha256": digest(payloads["run_namespace01.ps1"])}))
