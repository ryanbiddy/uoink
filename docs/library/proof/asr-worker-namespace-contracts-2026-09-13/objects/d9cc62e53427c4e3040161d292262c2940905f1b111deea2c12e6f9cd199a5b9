"""Seal existing preparation text only; never executes candidate code."""
from pathlib import Path
import hashlib
import json

HERE = Path(r"E:\AI\projects\uoink\checkouts\Yoink-library\_scratch\asr-worker-namespace-proposal01")
assert not (HERE / "MANIFEST.json").exists()
rows = []
for path in sorted(HERE.rglob("*")):
    if path.is_file():
        assert "runs" not in path.relative_to(HERE).parts
        raw = path.read_bytes()
        rows.append({"path": path.relative_to(HERE).as_posix(), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()})
raw = (json.dumps({"schema": "uoink.preparation-seal.v1", "payload_count": len(rows),
                  "payload_bytes": sum(row["bytes"] for row in rows), "candidate_executed": False, "files": rows}, indent=2) + "\n").encode()
with (HERE / "MANIFEST.json").open("xb") as stream:
    stream.write(raw)
print(json.dumps({"payload_count": len(rows), "payload_bytes": sum(row["bytes"] for row in rows), "manifest_sha256": hashlib.sha256(raw).hexdigest()}))
