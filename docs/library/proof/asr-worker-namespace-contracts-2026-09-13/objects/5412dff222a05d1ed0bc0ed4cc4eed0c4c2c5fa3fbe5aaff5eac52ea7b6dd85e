"""Data-only harness preparation: never imports/executes candidate modules."""
from pathlib import Path
import ast
import difflib
import hashlib
import json

ROOT = Path(r"E:\AI\projects\uoink\checkouts\Yoink-library")
HERE = ROOT / "_scratch/asr-worker-namespace-proposal01"
OLD = ROOT / "_scratch/asr-windows-lifecycle-proposal02"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def create(name, raw):
    with (HERE / name).open("xb") as stream:
        stream.write(raw)


old_raw = (OLD / "qualify_lifecycle.py").read_bytes()
assert sha(old_raw) == "563539d579a6584029f6596d6cba5de375976b6ada02535108cc195cb4fc3de7"
old = old_raw.decode("utf-8")
life = (OLD / "snapshot_lifecycle.py").read_bytes()
assert sha(life) == "a80514aac6b1e75b9b872052852fa993a23cd5273b6bed4ffb4eef7404cb69dd"
create("snapshot_lifecycle.py", life)
create("GUARD-BASELINE.py.txt", old_raw)
case_source = (HERE / "contract_cases.py").read_bytes()
tree = ast.parse(case_source)
names = []
for node in tree.body:
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
        for decorator in node.decorator_list:
            if isinstance(decorator, ast.Call) and isinstance(decorator.func, ast.Name) and decorator.func.id == "case":
                assert len(decorator.args) == 1 and isinstance(decorator.args[0], ast.Constant)
                names.append(decorator.args[0].value)
assert len(names) == len(set(names)) and all(type(name) is str for name in names)
modules = ("snapshot_lifecycle", "owned_generation_protocol", "pinned_buffer_namespace",
           "win32_worker_connection", "win32_private_pipe")
inputs = tuple(name + ".py" for name in modules) + ("contract_cases.py", "qualify_namespace.py")
prefix = old[:old.index('module = types.ModuleType("snapshot_lifecycle")')]
prefix = prefix.replace('"""UNEXECUTED synthetic proposal; no Windows/kernel/model ports exist here."""',
                        '"""Proposed in-memory qualification; all native calls use explicit fake seams."""')
prefix = prefix.replace("import dataclasses\n", "import dataclasses\nimport contextlib\nimport hmac\nimport struct\n")
prefix = prefix.replace("import dataclasses\r\n", "import dataclasses\r\nimport contextlib\r\nimport hmac\r\nimport struct\r\n")
prefix = prefix.replace('INPUTS = ("snapshot_lifecycle.py", "qualify_lifecycle.py")', "INPUTS = " + repr(inputs))
prefix = prefix.replace('ALLOWED_IMPORTS = set(sys.modules) | {"snapshot_lifecycle"}',
                        "ALLOWED_IMPORTS = set(sys.modules) | set(" + repr(modules) + ")")
loading = "\nfor module_name in " + repr(modules) + ":\n"
loading += "    module = types.ModuleType(module_name)\n    module.__file__ = os.path.join(HERE, module_name + '.py')\n"
loading += "    sys.modules[module_name] = module\n    exec(compile(RAW[module_name + '.py'], module.__file__, 'exec'), module.__dict__)\n"
loading += "exec(compile(RAW['contract_cases.py'], os.path.join(HERE, 'contract_cases.py'), 'exec'), globals())\n\n"
loading += "EXPECTED_CASES = " + repr(tuple(names)) + "\n"
suffix = old[old.index("assert tuple(name for name, _ in CASES) == EXPECTED_CASES"):]
suffix = suffix.replace("assert len(CASES) == 46", "assert len(CASES) == " + str(len(names)))
suffix = suffix.replace("uoink.lifecycle-state-synthetic.v1", "uoink.worker-namespace-synthetic.v1")
suffix = suffix.replace("In-memory fake ports only; no Windows or native model qualification",
                        "Generated-memory fake API seams only; no kernel, model, factory or native-loader qualification")
harness = (prefix + loading + suffix).replace("\r\n", "\n").encode()
ast.parse(harness)
create("qualify_namespace.py", harness)
create("GUARD-SETUP.diff", "".join(difflib.unified_diff(old.replace("\r\n", "\n").splitlines(True),
    harness.decode().splitlines(True), fromfile="qualified-lifecycle02", tofile="proposed-namespace01")).encode())
expected = {"schema": "uoink.namespace-expected-cases.v1", "count": len(names), "ordered_cases": names}
create("EXPECTED-CASES.json", (json.dumps(expected, indent=2) + "\n").encode())
hashes = {name: sha((HERE / name).read_bytes()) for name in inputs}
launcher = (OLD / "run_lifecycle02.ps1").read_text(encoding="utf-8")
launcher = launcher.replace("asr-windows-lifecycle-proposal02", "asr-worker-namespace-proposal01")
launcher = launcher.replace("lcs02", "nsp01").replace("lifecycle-fake-ports-46-only", "namespace-fake-api-" + str(len(names)) + "-only")
launcher = launcher.replace("qualify_lifecycle.py", "qualify_namespace.py").replace("run_lifecycle02.ps1", "run_namespace01.ps1")
launcher = launcher.replace("46", str(len(names)))
start = launcher.index("$taskExpected=@{")
end = launcher.index("$taskRecords=@()", start)
pins = "$taskExpected=@{\n" + "".join("    '" + name + "'='" + digest + "'\n" for name, digest in hashes.items()) + "}\n"
all_names = inputs + ("EXPECTED-CASES.json", "run_namespace01.ps1")
pins += "$taskInputNames=@(" + ",".join("'" + name + "'" for name in all_names) + ")\n"
launcher = launcher[:start] + pins + launcher[end:]
launcher = launcher.replace("uoink.lifecycle-expected-cases.v1", "uoink.namespace-expected-cases.v1")
launcher = launcher.replace("uoink.lifecycle-state-synthetic.v1", "uoink.worker-namespace-synthetic.v1")
launcher = launcher.replace("in-memory fake-port cases only", "generated-memory fake API cases only")
launcher = launcher.replace("$env:TRANSFORMERS_OFFLINE='1'", "$env:TRANSFORMERS_OFFLINE='1'\n$env:PYANNOTE_METRICS_ENABLED='0'")
# Do not accidentally rewrite digest characters while adapting a numeric count.
for name, digest in hashes.items():
    assert "'" + name + "'='" + digest + "'" in launcher
create("run_namespace01.ps1", launcher.replace("\r\n", "\n").encode())
admission = {"root_reviewed": False, "scope": "namespace-fake-api-" + str(len(names)) + "-only", "label": "nsp01",
             "input_sha256": {name: sha((HERE / name).read_bytes()) for name in all_names}, "expected_cases": names}
create("ADMISSION-TEMPLATE.json", (json.dumps(admission, indent=2) + "\n").encode())
parsed = []
for name in inputs:
    ast.parse((HERE / name).read_bytes())
    parsed.append(name)
create("STATIC-PREPARATION.json", (json.dumps({"candidate_executed": False, "case_count": len(names),
    "ast_parsed_only": parsed, "guard_baseline_sha256": sha(old_raw), "input_sha256": admission["input_sha256"]}, indent=2) + "\n").encode())
print(json.dumps({"prepared": True, "candidate_executed": False, "case_count": len(names), "input_sha256": admission["input_sha256"]}))
