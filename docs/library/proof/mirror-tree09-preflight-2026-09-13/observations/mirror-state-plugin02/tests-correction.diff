+def test_early_unconfigure_records_incomplete_session(tmp_path, monkeypatch, capsys):
+    observer = p.Observer(tmp_path/'incomplete-session.jsonl')
+    monkeypatch.setattr(p, '_OBSERVER', observer)
+    p.pytest_unconfigure(SimpleNamespace())
+    rows = records(observer.path)
+    assert rows[1]['event'] == 'observer_error' and rows[1]['stage'] == 'session_incomplete'
