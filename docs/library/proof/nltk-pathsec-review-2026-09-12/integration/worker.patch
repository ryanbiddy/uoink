+def run_child_probe(python_code: str, tree_site_dir: Path, timeout: int = 15) -> subprocess.CompletedProcess[str]:
+    """Execute python snippet in an isolated child process with bytecode disabled."""
+    env = os.environ.copy()
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    # The staged native libraries are cp313; do not load them into the test
+    # runner's possibly different interpreter. Start the matching embedded host
+    # with explicit paths and an audit guard before importing any package.
+    host = STAGING_SITE_PACKAGES.parent.parent / 'python.exe'
+    if not host.is_file():
+        pytest.skip('Matching staged Python interpreter is unavailable')
+    preamble = f"""
+import os, sys
+sys.path[:0] = {[str(tree_site_dir), str(STAGING_SITE_PACKAGES)]!r}
+def audit(event, args):
+    if event.startswith('socket.') or event == 'subprocess.Popen':
+        raise PermissionError('NLTK probe forbids network and subprocesses')
+    if event == 'import' and str(args[0]).split('.')[0] in ('torch', 'whisper', 'whisperx', 'pyannote'):
+        raise PermissionError('NLTK probe forbids model imports')
+    if event in ('open', 'sqlite3.connect') and isinstance(args[0], (str, bytes, os.PathLike)):
+        value = os.fsdecode(args[0]).replace(chr(92), '/').casefold()
+        forbidden = os.environ.get('IG_FORBIDDEN_LIVE', 'C:/Users/hello/AppData/Local/Uoink/index.db').replace(chr(92), '/').casefold()
+        if forbidden in value:
+            raise PermissionError('Live index forbidden')
+sys.addaudithook(audit)
+"""
+    cmd = [str(host), '-I', '-S', '-B', '-c', preamble + python_code]
+    return subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=timeout)
+
+
+def make_probe_sandbox_header(sandbox_dir: Path) -> str:
+    """Generate child-process header that pins allowed data roots strictly to sandbox_dir."""
+    return f"""
