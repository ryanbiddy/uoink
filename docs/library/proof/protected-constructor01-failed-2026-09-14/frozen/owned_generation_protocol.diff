+    def issue_admitted_namespace(self, adoption):
+        """Privately issue an exact namespace record bound to authenticated start, adopted ReadSet and manifest."""
+        _require(self._ready and self._started and not self._closed, "worker_generation_not_started")
+        _require(adoption is not None and adoption.read_set is not None
+                 and not adoption.read_set.unconfirmed and not adoption.read_set.released, "live_adoption_required")
+        if not adoption.materialization_started:
