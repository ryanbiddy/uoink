+                 "namespace_digest_binding_mismatch")
+        with self._owner_operation("issue"):
+            record = self.registry.issue_admitted_namespace(
+                self._permit, adoption.namespace, adoption.read_set, self._channel.binding.manifest_sha256)
+            self._admitted_namespace = record
+            return record
