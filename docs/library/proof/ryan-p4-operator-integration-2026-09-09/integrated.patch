+def hostile_sentinel(profile: Path, interpreter: Path) -> dict:
+    sentinel = profile / "client" / "protected-sentinel.bin"
+    before = sha_file(sentinel) if sentinel.is_file() else None
+    observer = profile / "kit" / "p4_observe_actions.py"
