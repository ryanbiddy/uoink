+    events = [json.loads(p.read_text(encoding="utf-8")) for p in (tmp_path / "client" / "action-records").glob("*.json")]
+    recall_events = [e for e in events if e["kind"] == "recall_hook"]
+    assert recall_events[0]["exit_code"] == 0
