+def _corpus(kind: str, url: str, body: str) -> str:
+    return (
+        f"# {SYNTHETIC_BANNER}\n\n"
+        f"**Source:** {url}\n"
+        f"**Fixture-kind:** {kind}\n\n"
+        f"{body}\n"
+    )
