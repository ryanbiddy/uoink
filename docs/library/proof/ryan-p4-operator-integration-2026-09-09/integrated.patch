+        "tool_input": {"marker": "full request input"},
+    }))
+    assert allowed.returncode == 0, allowed.stderr
+    assert json.loads(allowed.stdout)["hookSpecificOutput"]["permissionDecision"] == "allow"
+    denied = run("hook", json.dumps({
