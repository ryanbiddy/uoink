 MAX_OUTPUT = 6 * 1024 * 1024
 MAX_HEADER = 32 * 1024
+MAX_JSON_DEPTH = 3  # Root object, tensor descriptor, then shape/offset array.
 MAX_SECONDS = 30.0
 DATA_BYTES = 5_891_996
