+@case('depth_scanner_accepts_exact_three_container_boundary')
+def scanner_boundary():
+    raw=b'{"a":{"b":[0]}}'
+    assert reader.MAX_JSON_DEPTH==3
+    assert reader._header_document(raw,reader._Budget(30))=={'a':{'b':[0]}}
+
+@case('depth_scanner_refuses_four_before_json_loads')
+def scanner_next_level():
+    raw=b'{"a":{"b":[[0]]}}'
+    with patched(reader.json,'loads',bomb):
+        refuse(lambda:reader._header_document(raw,reader._Budget(30)),
+            'Malformed UTF-8 JSON header: nesting depth bound')
+
+@case('depth_scanner_ignores_string_brackets_quotes_and_backslashes')
+def scanner_strings():
+    samples=['[{]}', 'quote " with ] } [ {', 'backslash \\ then " and [',
+        *('\\'*count for count in range(1,5))]
+    for sample in samples:
+        document={'outer':{'key [ { " \\ } ]':[sample]}}
+        raw=json.dumps(document,separators=(',', ':')).encode('utf-8')
+        assert reader._header_document(raw,reader._Budget(30))==document
+
+@case('depth_scanner_detects_excess_after_escaped_string')
+def scanner_after_string():
+    document={'prefix':'\\" [ { } ]','deep':[[[0]]]}
+    raw=json.dumps(document,separators=(',', ':')).encode('utf-8')
+    with patched(reader.json,'loads',bomb):
+        refuse(lambda:reader._header_document(raw,reader._Budget(30)),
+            'Malformed UTF-8 JSON header: nesting depth bound')
+
+@case('depth_scanner_checks_deadline_during_bounded_scan')
+def scanner_deadline():
+    calls=[0]
+    def clock():
+        calls[0]+=1
+        return 0 if calls[0]<5 else 31
+    raw=b'{"a":"'+b'['*4096+b'"}'
+    with patched(reader.time,'monotonic',clock):
+        budget=reader._Budget(30)
+        refuse(lambda:reader._check_json_depth(raw,budget),'deadline exceeded')
+    assert calls[0]>=5
+
+@case('depth_scanner_refuses_unmatched_close_before_json_loads')
+def scanner_unmatched_close():
+    with patched(reader.json,'loads',bomb):
+        refuse(lambda:reader._header_document(b'{}}',reader._Budget(30)),
+            'Malformed UTF-8 JSON header: unmatched closing structure')
+
