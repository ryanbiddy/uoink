 "source_revision": "e628f17250ac64f2351a08d04b6034fd8a44e3c1e79e91c217b9f0039cc4e937", "video_id": "2091567513461309440"}}, "c158-2": {"card_key": "c158", "kind": "disposition", "support": {"card_hash": "3e952136719c42abd8ea48d228446c6ec79ca4af57fa4eea6d4fd03a40a0bc8d", "excerpt_id": "b3a64d328d304a2ec3f54cc46b04bec54da0bdfe9d56f9a0e961cd7c66a6a1b6", "quote": "I asked Kimi K3 to design a robot for deep sea research", "source_revision": "e628f17250ac64f2351a08d04b6034fd8a44e3c1e79e91c217b9f0039cc4e937", "video_id": "2091567513461309440"}}, "c162-1": {"card_key": "c162", "kind": "disposition", "support": {"card_hash": "405d5c3aeac35852ecb824fdb89174f47af98af053716af339399640d574eae1", "excerpt_id": "98b33901e8dac864ced9bb6d1fd7f283089117dfe668792fcacf4d29c832f5b1", "quote": "We rebuilt the streaming renderer to only touch what's still changing", "source_revision": "1236706a36f3e6a5d04fd76ac45e7747bf0f4be962183cde28a219a2aad2358b", "video_id": "2092006565285175296"}}, "c165-1": {"card_key": "c165", "kind": "candidate", "support": {"card_hash": "b6774e0fe8864004a4ad612753fa5ce1ca7caca99df0df66b93a51b7ed110303", "excerpt_id": "b27cedb1476bc57c470ec223eca5c58358651163df032e59687813fdc6fe40e3", "quote": "That's what the business of autonomous freight looks like", "source_revision": "b20d26a9f856eba338fcbbb716f70c202ebe1dd8db387067196a04d9d8f9f274", "video_id": "2092246969918144513"}}, "c165-2": {"card_key": "c165", "kind": "disposition", "support": {"card_hash": "b6774e0fe8864004a4ad612753fa5ce1ca7caca99df0df66b93a51b7ed110303", "excerpt_id": "b27cedb1476bc57c470ec223eca5c58358651163df032e59687813fdc6fe40e3", "quote": "That's what the business of autonomous freight looks like", "source_revision": "b20d26a9f856eba338fcbbb716f70c202ebe1dd8db387067196a04d9d8f9f274", "video_id": "2092246969918144513"}}, "c166-1": {"card_key": "c166", "kind": "disposition", "support": {"card_hash": "e84555e58a3b968cca72cb1fdf6208f052e926741c686a6ddadaa2f617002525", "excerpt_id": "6c87d1162dd97660c52d5448e947cfa9a58f11a2cfaa5727e11b949291b1645f", "quote": "training your own text-to-speech model from scratch on your own GPU", "source_revision": "f4cf5247b9315ef264a956067a4efadd0a31c09fb192b9b25e28e52ebcf51c98", "video_id": "2092254012456271872"}}, "c169-1": {"card_key": "c169", "kind": "candidate", "support": {"card_hash": "48bdda0921b539e7ad46ce689af599100b1d2b80d67f79a94b5a5130ba1a60f9", "excerpt_id": "cb8ffbdf0ceb127e03b24e70657485e573200d4707dfb8762a166bcdd3c0d1d5", "quote": "Open Source is eclipsing Closed Source in total token usage, but frontier labs still capture most revenue.", "source_revision": "c8210280e7c757e9ef0796508164fe65e644c593795894e26ebaf91a1ecbe182", "video_id": "2092682844812500992"}}, "c169-2": {"card_key": "c169", "kind": "disposition", "support": {"card_hash": "48bdda0921b539e7ad46ce689af599100b1d2b80d67f79a94b5a5130ba1a60f9", "excerpt_id": "cb8ffbdf0ceb127e03b24e70657485e573200d4707dfb8762a166bcdd3c0d1d5", "quote": "Open Source is eclipsing Closed Source in total token usage, but frontier labs still capture most revenue.", "source_revision": "c8210280e7c757e9ef0796508164fe65e644c593795894e26ebaf91a1ecbe182", "video_id": "2092682844812500992"}}, "c174-1": {"card_key": "c174", "kind": "candidate", "support": {"card_hash": "549aab30ef7306ec9e3246db06dc117011bef5a22ad08bb202e8a04e144d0ada", "excerpt_id": "7b6d57eefa7b4e8566f15c837095303ff62763e4d37027d2af0411e33fdf47fd", "quote": "In 2023, four MIT dropouts released a fork of Microsoft's code editor.", "source_revision": "70483878d4c47d88f938f94e15fe211c3106e3b0a590177a067ee66b9e0fadff", "video_id": "2093001292591632384"}}, "c174-2": {"card_key": "c174", "kind": "disposition", "support": {"card_hash": "549aab30ef7306ec9e3246db06dc117011bef5a22ad08bb202e8a04e144d0ada", "excerpt_id": "7b6d57eefa7b4e8566f15c837095303ff62763e4d37027d2af0411e33fdf47fd", "quote": "In 2023, four MIT dropouts released a fork of Microsoft's code editor.", "source_revision": "70483878d4c47d88f938f94e15fe211c3106e3b0a590177a067ee66b9e0fadff", "video_id": "2093001292591632384"}}, "c175-1": {"card_key": "c175", "kind": "candidate", "support": {"card_hash": "501e0278780921d1b7dab8211f1b93e0bfe226b59d85f15db1f546ee5212a3d5", "excerpt_id": "b94734bf6b6267a29c24bf5bbe3baabf3a42867d71f10d98fa39ecd11558c6c0", "quote": "we are going after the biggest market in the world. There's going to be competitors.", "source_revision": "a3a0fa6037bd70d0c48e915b743abcb4ab2de062331635bb25ea5b7682ee9837", "video_id": "2093043429278458326"}}, "c175-2": {"card_key": "c175", "kind": "disposition", "support": {"card_hash": "501e0278780921d1b7dab8211f1b93e0bfe226b59d85f15db1f546ee5212a3d5", "excerpt_id": "b94734bf6b6267a29c24bf5bbe3baabf3a42867d71f10d98fa39ecd11558c6c0", "quote": "we are going after the biggest market in the world. There's going to be competitors.", "source_revision": "a3a0fa6037bd70d0c48e915b743abcb4ab2de062331635bb25ea5b7682ee9837", "video_id": "2093043429278458326"}}, "c177-1": {"card_key": "c177", "kind": "candidate", "support": {"card_hash": "3a684953ebf52855d3f40ecfe9a364d551999e44dab3f8d1465da171c93f90bd", "excerpt_id": "134b17bb0c3056eae5da770592e095c609d69bb8744e9aab65c60e4ec45d78da", "quote": "we're now the only NeoCloud certified hypervisor from NVIDIA as a result of today's announcement", "source_revision": "27e9af48155d4e01df103295a105edfb71091bc7a657749531cb5b92e6a2b355", "video_id": "2093098700612517888"}}, "c177-2": {"card_key": "c177", "kind": "disposition", "support": {"card_hash": "3a684953ebf52855d3f40ecfe9a364d551999e44dab3f8d1465da171c93f90bd", "excerpt_id": "134b17bb0c3056eae5da770592e095c609d69bb8744e9aab65c60e4ec45d78da", "quote": "we're now the only NeoCloud certified hypervisor from NVIDIA as a result of today's announcement", "source_revision": "27e9af48155d4e01df103295a105edfb71091bc7a657749531cb5b92e6a2b355", "video_id": "2093098700612517888"}}, "c178-1": {"card_key": "c178", "kind": "candidate", "support": {"card_hash": "c738d5516446ded757fe231257779dac071634f97a4430be84cdcac57a5b2295", "excerpt_id": "809e084837a286b712ca63c42bbd28f42ab48ffcac01e46f7369428aad71116a", "quote": "the NVIDIA hugging face acquisition what does this mean for open source AI?", "source_revision": "de76f64a7287faa0e5c91a84e5e50ac64b4ac04e33828ca4535f1867705b9687", "video_id": "2093246582913171456"}}, "c178-2": {"card_key": "c178", "kind": "disposition", "support": {"card_hash": "c738d5516446ded757fe231257779dac071634f97a4430be84cdcac57a5b2295", "excerpt_id": "809e084837a286b712ca63c42bbd28f42ab48ffcac01e46f7369428aad71116a", "quote": "the NVIDIA hugging face acquisition what does this mean for open source AI?", "source_revision": "de76f64a7287faa0e5c91a84e5e50ac64b4ac04e33828ca4535f1867705b9687", "video_id": "2093246582913171456"}}, "c181-1": {"card_key": "c181", "kind": "disposition", "support": {"card_hash": "f31755d6cae87adc3114a0a2839fd15130c17145ca86d0239452d7338867d5ac", "excerpt_id": "f9434796e4224b8996fcc8a0964f14561fa3863b643e884465e386d32ca0db6b", "quote": "SOMEONE VIBE CODED A MOBILE APP WHERE ZOMBIES CHASE YOU IN REAL LIFE", "source_revision": "60c217c06f0f314c6b3ac28d87a23b79ebe0955abaaf04875b3d0acce387469c", "video_id": "2093534714439110656"}}, "c182-1": {"card_key": "c182", "kind": "disposition", "support": {"card_hash": "07e5f15d0345fc5b7d85dbcde78ed1832dee3240b1b2dab3f2aab02536055ccb", "excerpt_id": "784dbdb3af03a1e0aa007662716e12bace40954d7528fd8d474ab34641a33dbb", "quote": "You can create your own systems to simulate how the database would react to different numbers of requests", "source_revision": "e6c5583b88a67ddb8664eeb7b3e9298a600dd932bc0901a47f0f396c0670a8b7", "video_id": "2093591840171941888"}}, "c185-1": {"card_key": "c185", "kind": "candidate", "support": {"card_hash": "b4f9804d787c4bd546e02066fd6119346fc1d641d3030791f729839736a2e417", "excerpt_id": "1b8dc974aaa66588446a6221f0c4fe06b847db34239c726264baa57b2881888e", "quote": "how I'm changing my strategy for the AI era", "source_revision": "f583025b6a02bdb0eb48806e20e11ed414990490a423eba2908b72984decbbc1", "video_id": "2093996615065612288"}}, "c185-2": {"card_key": "c185", "kind": "disposition", "support": {"card_hash": "b4f9804d787c4bd546e02066fd6119346fc1d641d3030791f729839736a2e417", "excerpt_id": "1b8dc974aaa66588446a6221f0c4fe06b847db34239c726264baa57b2881888e", "quote": "how I'm changing my strategy for the AI era", "source_revision": "f583025b6a02bdb0eb48806e20e11ed414990490a423eba2908b72984decbbc1", "video_id": "2093996615065612288"}}, "c186-1": {"card_key": "c186", "kind": "disposition", "support": {"card_hash": "ecbdebe36dbd12fb7109411b72e7ea90b2de5e878476d59b3a277173b28182ad", "excerpt_id": "293ce9b6c896cf2f9ce3e621197cf86021b66cf88733bbf80cc061d40b702984", "quote": "made myself a Grok Pocket this weekend so i can take my grok bots on the go and easily switch between them", "source_revision": "3cda959837a94ebd906cc6b6fd4840afc13b20b689945891726dd59743621a48", "video_id": "2094122120032710656"}}, "c190-1": {"card_key": "c190", "kind": "disposition", "support": {"card_hash": "82641c93eb596f50d3479908fc3175a368c9427d25681deaa0775fd9b8213d9e", "excerpt_id": "840241708021f70d572807242a62fc2d38737954c271e9999e43968144edc8d7", "quote": "A new platform for infinite, interactive AI livestreams. Pick a channel, prompt what happens next, and watch it generate in real time.", "source_revision": "299ac3313adfeadcb0433fd494b52da0be526d5881c0cee7ac481a287b4228c6", "video_id": "2094286060456914944"}}, "c191-1": {"card_key": "c191", "kind": "candidate", "support": {"card_hash": "927c572f0a7b23be487d743cede49952a0665466a9eda6ab8f441b74a11c8288", "excerpt_id": "07b2fda06bf2f0cee969f402760cdb0ef0b2c8be831c3f4b3c56a2747f2193b2", "quote": "The AI future is unevenly distributed. What would the world look like with AI broadly diffused", "source_revision": "69e96723b252509a108573a9333527bdc4f5d5573d5b5b86914bd26a0cd81de0", "video_id": "2094452350132051968"}}, "c191-2": {"card_key": "c191", "kind": "disposition", "support": {"card_hash": "927c572f0a7b23be487d743cede49952a0665466a9eda6ab8f441b74a11c8288", "excerpt_id": "07b2fda06bf2f0cee969f402760cdb0ef0b2c8be831c3f4b3c56a2747f2193b2", "quote": "The AI future is unevenly distributed. What would the world look like with AI broadly diffused", "source_revision": "69e96723b252509a108573a9333527bdc4f5d5573d5b5b86914bd26a0cd81de0", "video_id": "2094452350132051968"}}, "c192-1": {"card_key": "c192", "kind": "candidate", "support": {"card_hash": "d03f6a684054dba0924e37ad52d4ce4927deadb04bfef06fd0ad6c93c25f5673", "excerpt_id": "f757ba6ad315a5b2ff827a4c2358554365e01f80bbbb8df6d8051037612247e9", "quote": "A forward deployed engineer embeds with your team and uses AI to build the workflows", "source_revision": "32a400599bd2f032b00ca10026b59c7e28da045fdc0d84cded2549ba3ec9f50c", "video_id": "2094517730636390400"}}, "c192-2": {"card_key": "c192", "kind": "disposition", "support": {"card_hash": "d03f6a684054dba0924e37ad52d4ce4927deadb04bfef06fd0ad6c93c25f5673", "excerpt_id": "f757ba6ad315a5b2ff827a4c2358554365e01f80bbbb8df6d8051037612247e9", "quote": "A forward deployed engineer embeds with your team and uses AI to build the workflows", "source_revision": "32a400599bd2f032b00ca10026b59c7e28da045fdc0d84cded2549ba3ec9f50c", "video_id": "2094517730636390400"}}, "c196-1": {"card_key": "c196", "kind": "disposition", "support": {"card_hash": "7706dda601a4813249c25b71ff6d48bd9c680da2d83e9a581ac51079d655cec2", "excerpt_id": "105d616c298da765c54641a80a7dc61a5eb80e1dc03c566d502a906a2acef7c6", "quote": "Dyson just released a new AI-powered toothbrush with an integrated 100,000-pixel macro lens camera for $499", "source_revision": "11df6958801bf5df65e0a3a16099a6d4605ed6a6205827c5cdaf5780dfd8d910", "video_id": "2094761457007157248"}}, "c201-1": {"card_key": "c201", "kind": "candidate", "support": {"card_hash": "f0408b18213c30302e9728a011fc267af9cee85d4d1475be68eac23baea8ec76", "excerpt_id": "5efbf435ed298e48f009033f6c7fe783feb1a16bfb2ba0b9817cd57607d81b88", "quote": "Mass applying is one of the fastest ways for you to get onto the do not call list", "source_revision": "51d24779d52b75025e22d393789f7c9b5e573efeee39efe598539c163929aa26", "video_id": "4OmEbeR3BtI"}}, "c201-2": {"card_key": "c201", "kind": "disposition", "support": {"card_hash": "f0408b18213c30302e9728a011fc267af9cee85d4d1475be68eac23baea8ec76", "excerpt_id": "5efbf435ed298e48f009033f6c7fe783feb1a16bfb2ba0b9817cd57607d81b88", "quote": "Mass applying is one of the fastest ways for you to get onto the do not call list", "source_revision": "51d24779d52b75025e22d393789f7c9b5e573efeee39efe598539c163929aa26", "video_id": "4OmEbeR3BtI"}}, "c202-1": {"card_key": "c202", "kind": "candidate", "support": {"card_hash": "6e7394f38a883dd0cb4dfd220dfcf8a18a23af1ffd91cdbbacc9023a34261150", "excerpt_id": "9f65bd202616e157e2f299e342d10d54e111c2e0edaa9eb0cafb1ec83ded814c", "quote": "I have a big list of things I have to make. So I have a few apps that are already running", "source_revision": "de2771dc015b237c38781356de805a65ad3b19f870bb78632e95549e8cf3a7c8", "video_id": "D4fkiQfzw_I"}}, "c202-2": {"card_key": "c202", "kind": "disposition", "support": {"card_hash": "6e7394f38a883dd0cb4dfd220dfcf8a18a23af1ffd91cdbbacc9023a34261150", "excerpt_id": "9f65bd202616e157e2f299e342d10d54e111c2e0edaa9eb0cafb1ec83ded814c", "quote": "I have a big list of things I have to make. So I have a few apps that are already running", "source_revision": "de2771dc015b237c38781356de805a65ad3b19f870bb78632e95549e8cf3a7c8", "video_id": "D4fkiQfzw_I"}}, "c203-1": {"card_key": "c203", "kind": "candidate", "support": {"card_hash": "62c9fa6eefdd854337411009b3b9d5ff3da74b5c9f443bc87135b4c2c0969a48", "excerpt_id": "7cd15bbeb976e66e5de1e4a8afcf781cab953fef0aaec565d5c9a0a785ec0b6f", "quote": "He doesn't have the normal credentials, right? He did like um he's self-taught as a programmer", "source_revision": "2c880b210c2584b8aa1aa6e326ceea7637cad384452b66605cbdc1530b0e3e93", "video_id": "F97xOWNph5A"}}, "c203-2": {"card_key": "c203",