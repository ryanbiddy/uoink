f2a2c8c7cfacd1a8ca87aa675d4edb7ab136ea0dc72aa2c0dff68f", "excerpt_id": "cd268850df8e16a5e69a5b64eed26cc047b30fecfdbb4c541fdc88744613e4e2", "quote": "the U.S. government imposing restrictions on Anthropic and resulting in us not getting the actual best models", "source_revision": "277de02691d3b97bb2a283e5884f0795e5ea0d1fbf7f5050e148d46bf01f4df8", "video_id": "2089391264878002260"}}, "c130-2": {"card_key": "c130", "kind": "disposition", "support": {"card_hash": "888b6e10e7f2a2c8c7cfacd1a8ca87aa675d4edb7ab136ea0dc72aa2c0dff68f", "excerpt_id": "cd268850df8e16a5e69a5b64eed26cc047b30fecfdbb4c541fdc88744613e4e2", "quote": "the U.S. government imposing restrictions on Anthropic and resulting in us not getting the actual best models", "source_revision": "277de02691d3b97bb2a283e5884f0795e5ea0d1fbf7f5050e148d46bf01f4df8", "video_id": "2089391264878002260"}}, "c133-1": {"card_key": "c133", "kind": "candidate", "support": {"card_hash": "251ed9e24673f3f03cf4f9714e270792fd56493daa641450ef428e0a5bb2ceaa", "excerpt_id": "6f654f8f0c3ffabc02ed38b0c9f57ff5dcd028c514db96d1d5b0827dc1b06640", "quote": "Every task your team runs defaults to the most expensive model available.", "source_revision": "08b5d76df923bf3407d7da8d1aea074a13c7350d25df3643747a3f80caddb517", "video_id": "2089726155008204800"}}, "c133-2": {"card_key": "c133", "kind": "disposition", "support": {"card_hash": "251ed9e24673f3f03cf4f9714e270792fd56493daa641450ef428e0a5bb2ceaa", "excerpt_id": "6f654f8f0c3ffabc02ed38b0c9f57ff5dcd028c514db96d1d5b0827dc1b06640", "quote": "Every task your team runs defaults to the most expensive model available.", "source_revision": "08b5d76df923bf3407d7da8d1aea074a13c7350d25df3643747a3f80caddb517", "video_id": "2089726155008204800"}}, "c134-1": {"card_key": "c134", "kind": "candidate", "support": {"card_hash": "0647cb4880c4ac2b941902b58fd3bc6ea92e919b018ba63530370c3609dc2689", "excerpt_id": "49677a515801d5c734dbe877c67122ab887284438e1dc6fad642150fac2336dd", "quote": "Exa is partnering with @firefox to power search for an AI browser for the open internet.", "source_revision": "150e202647fa5fdd39d51d65a2241da4724766de78a432d0d6c5d77580a498a7", "video_id": "2089757319974559744"}}, "c134-2": {"card_key": "c134", "kind": "disposition", "support": {"card_hash": "0647cb4880c4ac2b941902b58fd3bc6ea92e919b018ba63530370c3609dc2689", "excerpt_id": "49677a515801d5c734dbe877c67122ab887284438e1dc6fad642150fac2336dd", "quote": "Exa is partnering with @firefox to power search for an AI browser for the open internet.", "source_revision": "150e202647fa5fdd39d51d65a2241da4724766de78a432d0d6c5d77580a498a7", "video_id": "2089757319974559744"}}, "c137-1": {"card_key": "c137", "kind": "candidate", "support": {"card_hash": "46b19e03cc698fd7744fd996740d0c75085d76b9436014c700c65cd126787819", "excerpt_id": "0397c476df904197b387b1ce70766823feab5d92bcde59a5a8524e19924496db", "quote": "Just an Apple device, ARKit, and AI.", "source_revision": "b12889f7c1ce34b6845c88d947ba0203ec2f83410b40eb5a0157115ceb68cdfd", "video_id": "2089976684019933200"}}, "c137-2": {"card_key": "c137", "kind": "disposition", "support": {"card_hash": "46b19e03cc698fd7744fd996740d0c75085d76b9436014c700c65cd126787819", "excerpt_id": "0397c476df904197b387b1ce70766823feab5d92bcde59a5a8524e19924496db", "quote": "Just an Apple device, ARKit, and AI.", "source_revision": "b12889f7c1ce34b6845c88d947ba0203ec2f83410b40eb5a0157115ceb68cdfd", "video_id": "2089976684019933200"}}, "c140-1": {"card_key": "c140", "kind": "candidate", "support": {"card_hash": "50f5bfc5992d797b0c5f7952a712c94c7f8ae723b9f49666df02cc2773e06aa3", "excerpt_id": "e98d46024013370f08be3e4ade283f589eb297939cc8317edafd407d6b203e92", "quote": "I used Gemini 3.7 Flash in @antigravity to generate an Omni video in Google Sheets", "source_revision": "ba9e3bf8ca177989988516238a444cb76a5752aa57fd9336218bfc3944c76cd3", "video_id": "2090430819865165824"}}, "c140-2": {"card_key": "c140", "kind": "disposition", "support": {"card_hash": "50f5bfc5992d797b0c5f7952a712c9