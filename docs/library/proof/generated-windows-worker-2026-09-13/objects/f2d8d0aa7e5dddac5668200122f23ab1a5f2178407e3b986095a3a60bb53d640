"""Create the narrow native02 source derivative only; no candidate execution."""
from pathlib import Path
import ast
import difflib
import hashlib
import json

BASE = Path(r"E:\AI\projects\uoink\checkouts\Yoink-library")
OLD = BASE / "_scratch/asr-dummy-worker-flow-proposal01"
HERE = BASE / "_scratch/asr-dummy-worker-flow-proposal02"
EXPECTED = {"dummy_bootstrap.py": "8b7da115ef005c19ac872f14d7b5916a0d0df9bedbeff9d1970744cae4c0d91c",
            "generated_worker_flow.py": "7d9f4efef3641e08d2d2b1f5e57417b055d4b009e92da3c1d92a6896b3e3ced0",
            "run_native01.ps1": "b8fc3ce2e2649d1b0f18f0a31395b1121102ed0dd4eefd4f8ca58d5d86e993d1"}


def read(path):
    with path.open("rb") as stream:
        raw = stream.read(1048577)
    assert len(raw) <= 1048576
    return raw


def write(name, raw):
    path = HERE / name
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(raw)


rows = []
for name, expected in EXPECTED.items():
    raw = read(OLD / name)
    assert hashlib.sha256(raw).hexdigest() == expected
    write("before/" + name, raw)
    text = raw.decode()
    new_name = name
    if name == "dummy_bootstrap.py":
        text = text.replace("import encodings.utf_16_le\n", "import encodings.utf_16_le\nimport warnings\n")
        text = text.replace("asr-dummy-worker-native01", "asr-dummy-worker-native02")
        text = text.replace('    r"C:\\Python314\\Lib\\ctypes\\_endian.py":',
            '    r"C:\\Python314\\Lib\\ctypes\\_layout.py": (11772, "13eb492c805248ffd411aa4d61e4de90dbd89ef05b5c85152262847c690a7916"),\n    r"C:\\Python314\\Lib\\ctypes\\_endian.py":')
        text = text.replace('{"ctypes", "ctypes._endian", "_ctypes"}', '{"ctypes", "ctypes._endian", "ctypes._layout", "_ctypes"}')
        text = text.replace('if name in ("ctypes", "ctypes._endian"):', 'if name in ("ctypes", "ctypes._endian", "ctypes._layout"):')
        old_line = '            origin = r"C:\\Python314\\Lib\\ctypes\\__init__.py" if name == "ctypes" else r"C:\\Python314\\Lib\\ctypes\\_endian.py"'
        new_line = '            origin = {"ctypes": r"C:\\Python314\\Lib\\ctypes\\__init__.py", "ctypes._endian": r"C:\\Python314\\Lib\\ctypes\\_endian.py", "ctypes._layout": r"C:\\Python314\\Lib\\ctypes\\_layout.py"}[name]'
        assert text.count(old_line) == 1
        text = text.replace(old_line, new_line)
        old_denial = '        DENIALS.append(event)\n        raise RuntimeError("Fixed dummy boundary refused " + event)'
        new_denial = '        detail = event\n        if event == "import" and type(args[0]) is str and len(args[0]) <= 128 and all(char.isascii() and (char.isalnum() or char in "._") for char in args[0]):\n            detail += ":" + args[0]\n        DENIALS.append(detail)\n        raise RuntimeError("Fixed dummy boundary refused " + detail)'
        assert text.count(old_denial) == 1
        text = text.replace(old_denial, new_denial)
        ast.parse(text)
    elif name == "run_native01.ps1":
        new_name = "run_native02.ps1"
        text = text.replace("asr-dummy-worker-flow-proposal01", "asr-dummy-worker-flow-proposal02")
        text = text.replace("asr-dummy-worker-native01", "asr-dummy-worker-native02").replace("run_native01.ps1", "run_native02.ps1")
        text = text.replace("'C:\\Python314\\Lib\\ctypes\\_endian.py')", "'C:\\Python314\\Lib\\ctypes\\_endian.py','C:\\Python314\\Lib\\ctypes\\_layout.py')")
        text = text.replace("native_bindings.PSObject.Properties).Count -ne 8", "native_bindings.PSObject.Properties).Count -ne 9")
    changed = text.encode()
    if name == "generated_worker_flow.py":
        assert changed == raw
    write(new_name, changed)
    if changed != raw:
        write(name + ".diff", "".join(difflib.unified_diff(raw.decode().splitlines(True), text.splitlines(True),
              fromfile="frozen-native01/" + name, tofile="proposed-native02/" + new_name)).encode())
    rows.append({"old_name": name, "new_name": new_name, "before_sha256": expected,
                 "after_sha256": hashlib.sha256(changed).hexdigest()})
helper = read(OLD / "prepare_native_inputs.py").decode()
helper = helper.replace("asr-dummy-worker-flow-proposal01", "asr-dummy-worker-flow-proposal02")
helper = helper.replace("assert len(native) == 8", "assert len(native) == 9").replace("run_native01.ps1", "run_native02.ps1")
write("prepare_native_inputs.py", helper.encode())
layout = read(Path(r"C:\Python314\Lib\ctypes\_layout.py"))
assert len(layout) == 11772 and hashlib.sha256(layout).hexdigest() == "13eb492c805248ffd411aa4d61e4de90dbd89ef05b5c85152262847c690a7916"
write("retained-ctypes-layout.py.txt", layout)
write("DERIVATIVE-MAPPING.json", (json.dumps({"native_or_candidate_execution": False, "files": rows}, indent=2) + "\n").encode())
print(json.dumps({"prepared": True, "candidate_executed": False, "mapping": rows}))
