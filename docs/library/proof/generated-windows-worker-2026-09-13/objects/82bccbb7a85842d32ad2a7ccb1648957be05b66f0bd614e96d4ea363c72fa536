                     and isinstance(node.targets[0].value, ast.Attribute)
                     and node.targets[0].value.attr == "functions")
assert exit_names == ("GetExitCodeProcess",) and module_names == ("GetModuleFileNameW",)
parts.update(exit=exit_names, module_path=module_names)
symbols = next(ast.literal_eval(node.value) for node in tree.body if isinstance(node, ast.Assign)
               and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "SYMBOLS")
names = tuple(name for values in parts.values() for name in values)
assert tuple(map(len, parts.values())) == (19, 10, 1, 1)
assert len(names) == len(set(names)) == 31
assert set(names) == symbols - {"GetLastError"}
