$taskStderr=Join-Path $taskRun 'controller-stderr.log'
# BEGIN EXACT NATIVE RECEIPT BLOCK
$PSNativeCommandUseErrorActionPreference=$false
$global:LASTEXITCODE=$null
& $taskPython -I -S -B (Join-Path $taskRun 'dummy_bootstrap.py') controller 1> $taskStdout 2> $taskStderr
$taskNativeExit=$global:LASTEXITCODE
$taskNativeReceipt=[ordered]@{schema='uoink.native-exit.v1';child_returned=$true;native_exit=$taskNativeExit}
$taskNativeBytes=[Text.UTF8Encoding]::new($false).GetBytes(($taskNativeReceipt | ConvertTo-Json -Compress))
$taskNativeStream=[IO.File]::Open((Join-Path $taskRun 'native-exit.json'),[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
try{$taskNativeStream.Write($taskNativeBytes,0,$taskNativeBytes.Length);$taskNativeStream.Flush($true)}finally{$taskNativeStream.Dispose()}
if($taskNativeExit -isnot [int]){throw 'Native exit was not captured as an integer'}
# END EXACT NATIVE RECEIPT BLOCK
$taskUnchanged=$true
$taskAfter=@()
foreach($taskSource in $taskSources){
    $taskCopyHash=(Get-FileHash -LiteralPath (Join-Path $taskRun $taskSource.name) -Algorithm SHA256).Hash.ToLowerInvariant()
    $taskSourceHash=(Get-FileHash -LiteralPath $taskSource.path -Algorithm SHA256).Hash.ToLowerInvariant()
    if($taskCopyHash -cne $taskSource.sha256 -or $taskSourceHash -cne $taskSource.sha256){$taskUnchanged=$false}
    $taskAfter += [ordered]@{name=$taskSource.name;before_sha256=$taskSource.sha256;copy_after_sha256=$taskCopyHash;source_after_sha256=$taskSourceHash}
}
$taskNativeAfter=@()
$taskControlAfter=@()
foreach($taskControl in $taskControls){
    $taskOriginalHash=(Get-FileHash -LiteralPath $taskControl.path -Algorithm SHA256).Hash.ToLowerInvariant()
    $taskCopyHash=(Get-FileHash -LiteralPath (Join-Path $taskRun $taskControl.name) -Algorithm SHA256).Hash.ToLowerInvariant()
    if($taskOriginalHash -cne $taskControl.sha256 -or $taskCopyHash -cne $taskControl.sha256){$taskUnchanged=$false}
    $taskControlAfter += [ordered]@{name=$taskControl.name;before_sha256=$taskControl.sha256;source_after_sha256=$taskOriginalHash;copy_after_sha256=$taskCopyHash}
}
foreach($taskBefore in $taskNativeBefore){
    $taskFile=Get-Item -LiteralPath $taskBefore.path
    $taskHash=(Get-FileHash -LiteralPath $taskBefore.path -Algorithm SHA256).Hash.ToLowerInvariant()
    if($taskFile.Length -ne $taskBefore.bytes -or $taskHash -cne $taskBefore.sha256){$taskUnchanged=$false}
    $taskNativeAfter += [ordered]@{path=$taskBefore.path;before_sha256=$taskBefore.sha256;after_sha256=$taskHash;bytes=$taskFile.Length}
}
$taskFixtureAfter=(Get-FileHash -LiteralPath $taskFixture -Algorithm SHA256).Hash.ToLowerInvariant()
if($taskFixtureAfter -cne $taskFixtureBefore){$taskUnchanged=$false}
[ordered]@{sources=$taskAfter;controls=$taskControlAfter;native_inputs=$taskNativeAfter;fixture_before_sha256=$taskFixtureBefore;fixture_after_sha256=$taskFixtureAfter;inputs_unchanged=$taskUnchanged} | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $taskRun 'after.json') -Encoding utf8
$taskReceiptValid=$false
$taskReceiptError=$null
try{
    $taskControllerPath=Join-Path $taskRun 'controller-result.json'
    $taskChildPath=Join-Path $taskRun 'child-result.json'
    if((Get-Item -LiteralPath $taskControllerPath).Length -gt 131072 -or (Get-Item -LiteralPath $taskChildPath).Length -gt 131072){throw 'Receipt bound exceeded'}
    $taskController=Get-Content -LiteralPath $taskControllerPath -Raw | ConvertFrom-Json
    $taskChild=Get-Content -LiteralPath $taskChildPath -Raw | ConvertFrom-Json
    $taskReceiptValid=$true
    foreach($taskReceipt in @($taskController,$taskChild)){
        if($taskReceipt.schema -cne 'uoink.generated-owned-worker.v1' -or $taskReceipt.guard_valid -cne $true -or $taskReceipt.native_exit_planned -ne 0 -or $taskReceipt.model_calls -ne 0 -or @($taskReceipt.model_imports).Count -ne 0 -or @($taskReceipt.guard_denials).Count -ne 0 -or $taskReceipt.metadata_traps -ne 12 -or $taskReceipt.registry_traps -ne 25 -or $taskReceipt.kernel32_path_verified -cne $true -or $null -ne $taskReceipt.error_type){$taskReceiptValid=$false}
        if($taskReceipt.work_budget_closed -cne $false -or @($taskReceipt.reserved_cleanup_calls).Count -ne 0){$taskReceiptValid=$false}
        foreach($taskName in $taskSourceNames){if($taskReceipt.source_sha256.$taskName -cne $taskSourceMap.source_sha256.$taskName){$taskReceiptValid=$false}}
    }
    $taskResult=$taskController.result
    if($taskController.role -cne 'controller' -or $taskChild.role -cne 'child' -or $taskChild.result.child_flow_return -ne 0 -or $taskNativeExit -ne 0){$taskReceiptValid=$false}
    if(@($taskController.native_api_calls | Where-Object {$_ -ceq 'CreateProcessW'}).Count -ne 1 -or @($taskChild.native_api_calls | Where-Object {$_ -ceq 'CreateProcessW'}).Count -ne 0){$taskReceiptValid=$false}
    if($taskResult.lifecycle_phase -ne 8 -or $taskResult.read_set_released -cne $true -or $taskResult.pipe_retired -cne $true -or $taskResult.controller_handshake_begun -cne $true -or $taskResult.model_calls -ne 0){$taskReceiptValid=$false}
    if($taskResult.generated_result.characters -ne 40000 -or $taskResult.exit_observation.child_native_exit -ne 0 -or $taskResult.exit_observation.process_wait_observed -cne $true -or $taskResult.exit_observation.job_active_processes -ne 0){$taskReceiptValid=$false}
    if($taskResult.parent_guard_retirement.parent_originals_closed -cne $true -or $taskResult.parent_guard_retirement.parent_inheritable_copies_closed -cne $true -or $taskResult.parent_guard_retirement.exact_child_alive_after_parent_close -cne $true -or @($taskResult.parent_guard_retirement.parent_original_values).Count -ne 1 -or @($taskResult.parent_guard_retirement.child_guard_values).Count -ne 1){$taskReceiptValid=$false}
