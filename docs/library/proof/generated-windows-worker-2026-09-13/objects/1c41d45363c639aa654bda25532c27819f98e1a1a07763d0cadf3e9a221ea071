$taskNativePaths=@('C:\Python314\python.exe','C:\Python314\python314.dll','C:\Python314\python3.dll','C:\Python314\DLLs\_ctypes.pyd','C:\Python314\DLLs\libffi-8.dll','C:\Windows\System32\kernel32.dll','C:\Python314\Lib\ctypes\__init__.py','C:\Python314\Lib\ctypes\_endian.py','C:\Python314\Lib\ctypes\_layout.py')
if(@($taskSourceMap.source_sha256.PSObject.Properties).Count -ne 6 -or @($taskSourceMap.source_paths.PSObject.Properties).Count -ne 6 -or @($taskSourceMap.native_bindings.PSObject.Properties).Count -ne 9){throw 'Fixed input membership refused'}
$taskSources=@()
foreach($taskName in $taskSourceNames){
    $taskExpectedSource=Join-Path $taskProposal $taskName
    if($taskName -in @('snapshot_lifecycle.py','owned_generation_protocol.py','win32_worker_connection.py','win32_private_pipe.py')){$taskExpectedSource=Join-Path 'E:\AI\projects\uoink\checkouts\Yoink-library\_scratch\asr-worker-namespace-proposal01' $taskName}
    if($taskSourceMap.source_paths.$taskName -cne $taskExpectedSource){throw 'Fixed source path mismatch'}
    $taskHash=(Get-FileHash -LiteralPath $taskExpectedSource -Algorithm SHA256).Hash.ToLowerInvariant()
    if($taskHash -cne $taskSourceMap.source_sha256.$taskName){throw 'Source input mismatch'}
    $taskSources += [ordered]@{name=$taskName;path=$taskExpectedSource;sha256=$taskHash}
}
$taskNativeBefore=@()
foreach($taskPath in $taskNativePaths){
    $taskBinding=$taskSourceMap.native_bindings.$taskPath
    $taskFile=Get-Item -LiteralPath $taskPath
    $taskHash=(Get-FileHash -LiteralPath $taskPath -Algorithm SHA256).Hash.ToLowerInvariant()
    if($taskFile.Length -ne $taskBinding.bytes -or $taskHash -cne $taskBinding.sha256){throw 'Existing native input changed'}
    $taskNativeBefore += [ordered]@{path=$taskPath;bytes=$taskFile.Length;sha256=$taskHash;file_version=$taskFile.VersionInfo.FileVersion}
}
New-Item -ItemType Directory -Path $taskRun -ErrorAction Stop | Out-Null
foreach($taskSource in $taskSources){
    Copy-Item -LiteralPath $taskSource.path -Destination (Join-Path $taskRun $taskSource.name) -ErrorAction Stop
    if((Get-FileHash -LiteralPath (Join-Path $taskRun $taskSource.name) -Algorithm SHA256).Hash.ToLowerInvariant() -cne $taskSource.sha256){throw 'Source copy changed'}
}
foreach($taskControl in $taskControls){
    Copy-Item -LiteralPath $taskControl.path -Destination (Join-Path $taskRun $taskControl.name) -ErrorAction Stop
    if((Get-FileHash -LiteralPath (Join-Path $taskRun $taskControl.name) -Algorithm SHA256).Hash.ToLowerInvariant() -cne $taskControl.sha256){throw 'Control input copy changed'}
