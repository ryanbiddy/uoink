+    assert trace.cycle_edge(0, 3, 1)["role"] == "dict.parent_field_value"
+    assert trace.cycle_edge(0, 3, 3)["role"] == "dict.content_field_value"
+    assert trace.cycle_edge(0, 3, 3)["edge_index"] == 3
