+
+def live_index_guard(live_index: Path) -> dict[str, Any]:
+    """Store the forbidden live-index path as a string. Never open or hash it."""
+    path = Path(live_index)
+    return {
+        "path": str(path),
+        "opened": False,
+        "hashed": False,
+        "exists_probed": False,
+        "mtime_ns": None,
+        "sha256": None,
