: false, "shelf_id": "ai-agents-and-automation"}, {"definition": "News and commentary on the AI industry's competitive, financial, and policy dynamics, including company rivalries, revenue and market share, government restrictions on AI companies, and market/usage economics.", "exclude": ["technical model architecture, benchmarks, or capability evaluation -\u003e AI and ML / Frontier Models", "an agent product demonstrating task execution itself -\u003e AI and ML / AI Agents and Automation", "a finished AI-generated creative artifact shown as the output -\u003e AI and ML / Generative Media", "coding-tool usage or IDE/SDK workflow steps -\u003e AI and ML / Developer Tools", "technical safety, sandboxing, prompt-injection or jailbreak defenses -\u003e AI and ML / Security"], "include": ["executive or public figure names who is winning the AI competitive race", "government policy or restriction reported as affecting an AI company's competitive position (takes precedence over AI and ML / Security, which covers technical safety and guardrails)", "commentary that a company now faces real competition in the AI market", "industry-wide analysis of usage share versus revenue capture between open and closed AI providers", "reported revenue or annual recurring revenue (ARR) figures for an AI company"], "name": "AI Industry and Business", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "AI Industry and Business"], "retired": false, "shelf_id": "ai-industry-and-business"}, {"definition": "Software engineering tooling, agent harnesses, IDE extensions, coding assistants, SDKs, and developer-focused workflows.", "exclude": ["consumer conversational chatbots", "pure theoretical ML papers without tools", "non-technical end-user products"], "include": ["coding assistants", "agent harnesses", "developer workflows", "software development SDKs", "IDE integrations", "code generation"], "name": "Developer Tools", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "Developer Tools"]