elf_id": "space-and-science"}, {"definition": "AI agent and assistant products that act for a user or business: agents that autonomously execute multi-step real-world tasks or business workflows, sensing and acting companions that see, hear, remember and respond like a coworker or friend, and proposed persistent assistants that continuously watch a user's screen or meetings.", "exclude": ["coding-specific agent harnesses, IDE tools, or SDKs for software engineers -\u003e AI and ML / Developer Tools", "model architecture or benchmark evaluation without a shown agent or assistant acting for a user -\u003e AI and ML / Frontier Models", "a finished generated video, image, or film shown as creative output -\u003e AI and ML / Generative Media", "company market position, revenue, funding, or rivalry commentary without a product acting for a user -\u003e AI and ML / AI Industry and Business", "technical AI safety or security controls, including monitoring to detect prompt injection or enforce runtime guardrails -\u003e AI and ML / Security"], "include": ["companion or assistant product described as sensing, hearing, acting, remembering and understanding the user like a coworker or friend", "agent completes multi-step real-world tasks end-to-end (booking, shopping, research) without step-by-step direction (takes precedence over AI and ML / Developer Tools when the user is not doing software engineering)", "AI agents autonomously running full business functions (sales, underwriting, coaching) without human operators", "agent-driven workflow where agents autonomously plan, execute, and deliver on a stated goal", "proposed persistent assistant that continuously watches the user's screen or meetings for personal assistance, rather than technical safety or security control (takes precedence over AI and ML / Security for this personal-assistance case)"], "name": "AI Agents and Automation", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "AI Agents and Automation"], "retired": false, "shelf_id": "ai-agents-and-automation"}, {"definition": "News and commentary on the AI industry's competitive, financial, and policy dynamics, including company rivalries, revenue and market share, government restrictions on AI companies, and market/usage economics.", "exclude": ["technical model architecture, benchmarks, or capability evaluation -\u003e AI and ML / Frontier Models", "an agent product demonstrating task execution itself -\u003e AI and ML / AI Agents and Automation", "a finished AI-generated creative artifact shown as the output -\u003e AI and ML / Generative Media", "coding-tool usage or IDE/SDK workflow steps -\u003e AI and ML / Developer Tools", "technical safety, sandboxing, prompt-injection or jailbreak defenses -\u003e AI and ML / Security"], "include": ["executive or public figure names who is winning the AI competitive race", "government policy or restriction reported as affecting an AI company's competitive position (takes precedence over AI and ML / Security, which covers technical safety and guardrails)", "commentary that a company now faces real competition in the AI market", "industry-wide analysis of usage share versus revenue capture between open and closed AI providers", "reported revenue or annual recurring revenue (ARR) figures for an AI company"], "name": "AI Industry and Business", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "AI Industry and Business"], "retired": false, "shelf_id": "ai-industry-and-business"}, {"definition": "Software engineering tooling, agent harnesses, IDE extensions, coding assistants, SDKs, and developer-focused workflows.", "exclude": ["consumer conversational chatbots", "pure theoretical ML papers without tools", "non-technical end-user products"], "include": ["coding assistants", "agent harnesses", "developer workflows", "software development SDKs", "IDE integrations", "code generation"], "name": "Developer Tools", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "Developer Tools"], "retired": false, "shelf_id": "developer-tools"}, {"definition": "Lectures, pedagogical explanations, conceptual deep dives, tutorials, and fundamental principles of machine learning.", "exclude": ["product announcements", "marketing keynotes", "opinion pieces without pedagogical content"], "include": ["introductory lectures", "algorithm explanations", "machine learning coursework", "mathematical foundations", "step-by-step technical tutorials"], "name": "Education", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "Education"], "retired": false, "shelf_id": "education"}, {"definition": "Architectures, capability evaluations, multimodal systems, scaling behavior, and releases of frontier foundation models.", "exclude": ["routine fine-tuning on niche tasks", "end-user application tutorials", "general AI business news"], "include": ["foundation model architectures", "multimodal model releases", "scaling laws", "model capabilities benchmarks", "open weights models"], "name": "Frontier Models", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "Frontier Models"], "retired": false, "shelf_id": "frontier-models"}, {"definition": "AI systems and products whose demonstrated output is a finished visual creative artifact -- animation, film, or image/video-generated website -- produced from prompts or automated pipelines.", "exclude": ["release coverage whose excerpt centers on architecture, scaling or benchmarks without a finished generated artifact -\u003e AI and ML / Frontier Models", "an agent autonomously completing a real-world non-creative task -\u003e AI and ML / AI Agents and Automation", "company market position or revenue commentary -\u003e AI and ML / AI Industry and Business", "a coding/SDK workflow used to build the artifact rather than the artifact itself -\u003e AI and ML / Developer Tools"], "include": ["prompt-driven 3D or claymation-style animation generated as the shown output", "an AI-generated short film entered in or winning an AI-specific fil