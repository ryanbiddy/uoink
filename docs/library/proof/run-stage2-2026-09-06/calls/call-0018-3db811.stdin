rce_cues", "truncated": true}, {"deep_link": "https://x.com/LunarResearcher/status/2083317178711921133#t=1917", "end": 2036.829, "evidence_kind": "timed_clip", "excerpt_id": "7e0077f23ffb6168e55183719f12d95e3a4a2c93ec3cf6980b819de2a2c1d5c7", "start": 1917.95, "text": "To Production So I've Got To Orchestrate It I Gotta Put Tracing In I Gotta Label Those Things Build Eval's And Then I Need Some Guardrails These Are The Rough Components The Companies That Do Only One Part Of That Chain Are The Ones I Don't", "timing": "source_cues", "truncated": true}], "hint": null, "platform": "x", "profile": "librarian", "schema_version": 1, "selection_version": "spread-longest-v1", "slug": "Lunar_-_OpenAI_pays_FDE_engineers_up_to_785K_year_In_this_40-minute_talk", "source_revision": "f4184203b0e5a1422f86a0c3bf31a671861e14a9577a452edb4c5798e83b5107", "source_type": "x_thread", "status": "evidenced", "summary_hint": null, "title": "Lunar - OpenAI pays FDE engineers up to $785K/year.  In this 40-minute talk, ...", "topic": "AI and ML", "truncated": true, "truncation": {"byte_budget": true, "fields": ["hint"], "selection": true}, "url": "https://x.com/LunarResearcher/status/2083317178711921133", "video_id": "2083312428356411392", "yoinked_at": "2026-08-01T07:52:14"}
