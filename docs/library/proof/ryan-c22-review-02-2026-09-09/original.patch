+def _package(scratch: Path) -> tuple[Path, str]:
+    path = scratch / "Uoink-Setup-synthetic.exe"
+    path.write_bytes(b"C22-SYNTHETIC-PACKAGE")
+    return path, _sha(path.read_bytes())
