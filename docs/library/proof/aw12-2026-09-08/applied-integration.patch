+def _late_atomic_local_body(env, monkeypatch, session):
+    env.mirror._lock_acquired = True
+    env.mirror._lock_generation = 4
+    env.mirror._op_seq = 10
+    plan = {"op_id": 10, "lock_generation": 4, "io": session}
