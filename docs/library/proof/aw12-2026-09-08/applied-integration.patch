+    handle, err = _win_create_file(
+        path,
+        generic_read | generic_write | delete_access,
+        file_share_read,
+        create_new,
+        file_attribute_normal | file_flag_open_reparse_point,
+    )
+    if handle is None:
+        raise OSError(err, "CreateFileW write failed", path, err)
