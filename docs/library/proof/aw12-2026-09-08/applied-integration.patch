+            env.mirror._write_intent("item:a", {"key": "item:a", "generation": 2, "mark": "late"})
+        except OSError:
+            pass
+        finally:
+            if not finished.is_set():
+                finished.set()
+
+    thread = threading.Thread(target=late_write)
+    thread.start()
+    try:
+        assert entered.wait(3)
