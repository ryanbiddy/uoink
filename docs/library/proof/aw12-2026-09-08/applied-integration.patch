+    info = FILE_RENAME_INFO()
+    info.ReplaceIfExists = 1 if replace_if_exists else 0
+    info.RootDirectory = None
+    info.FileNameLength = len(name) * ctypes.sizeof(wintypes.WCHAR)
+    info.FileName = name
