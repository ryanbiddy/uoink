nce_kind": "timed_clip", "excerpt_id": "cbfa354f3610ce67f8ff82baf6627edc56643b8cf2957afb898b6d0cbfe9cd40", "start": 418.55, "text": "\u003e\u003e The only way to validate an idea is to ship it with a buy button. Now with AI that it's even easier to ship stuff. This even more true. I have a slightly controversial take on AI is that there's a bunch of people who are obsessed with pr", "timing": "source_cues", "truncated": true}], "hint": null, "platform": "youtube", "profile": "librarian", "schema_version": 1, "selection_version": "spread-longest-v2", "slug": "How_I_Work_77K_Month_Solopreneur", "source_revision": "de2771dc015b237c38781356de805a65ad3b19f870bb78632e95549e8cf3a7c8", "source_type": "video", "status": "evidenced", "summary_hint": null, "title": "How I Work: $77K/Month Solopreneur", "topic": "Playlist", "truncated": true, "truncation": {"byte_budget": true, "fields": ["hint"], "selection": true}, "url": "https://www.youtube.com/watch?v=D4fkiQfzw_I", "video_id": "D4fkiQfzw_I", "yoinked_at": "2026-05-16T14:21:59"}
