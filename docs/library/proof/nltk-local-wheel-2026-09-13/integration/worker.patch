+def test_wheel_file_not_found(tmp_path: Path) -> None:
+    non_existent = tmp_path / "nltk-3.10.3-py3-none-any.whl"
+    out_dir = tmp_path / "out"
+    with pytest.raises(FileNotFoundError, match="Input wheel file not found"):
