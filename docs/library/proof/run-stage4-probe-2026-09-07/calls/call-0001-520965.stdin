, "excerpt_id": "a3633d10a669ecaae451ae5b0a42f1db274f3d4b13734266fc9b92150cad11ca", "start": 839.72, "text": "work with. Instead of applying, before you submit your application, try to get it as an employee referral. There is a slim possibility that you can get past a do not hire list if you come with an endorsement first. But, that's probably the ", "timing": "coarse", "truncated": true}], "hint": null, "platform": "youtube", "profile": "librarian", "schema_version": 1, "selection_version": "spread-longest-v2", "slug": "The_Do-Not-Hire_List_Is_Real_Here_s_What_Actually_Gets_You_On_It", "source_revision": "51d24779d52b75025e22d393789f7c9b5e573efeee39efe598539c163929aa26", "source_type": "video", "status": "evidenced", "summary_hint": null, "title": "The 'Do-Not-Hire List' Is Real. Here's What Actually Gets You On It.", "topic": "Job Hunt and Career", "truncated": true, "truncation": {"byte_budget": true, "fields": ["hint"], "selection": true}, "url": "https://www.youtube.com/watch?v=4OmEbeR3BtI", "video_id": "4OmEbeR3BtI", "yoinked_at": "2026-07-07T23:04:44"}
