", "excerpt_id": "a7596e500736c326f1c3ebdd4352f81b78236997d8c0d0da6f5e4826af9c41a6", "start": 519.029, "text": "created a new branch for me to work on. I want to adjust the jobs page design just a bit. This might be crazy, but let's make the job cards full width on the page. Vzero cooked on that. And huh, I don't love that choice that I've made, but ", "timing": "source_cues", "truncated": true}], "hint": null, "platform": "youtube", "profile": "librarian", "schema_version": 1, "selection_version": "spread-longest-v1", "slug": "Vercel_Product_Walkthrough_2026", "source_revision": "aade91be392bdba35246bfd2854073bb2b9d887a2d18f9550c1480179527a82c", "source_type": "video", "status": "evidenced", "summary_hint": null, "title": "Vercel Product Walkthrough (2026)", "topic": "AI and ML", "truncated": true, "truncation": {"byte_budget": true, "fields": ["hint"], "selection": true}, "url": "https://www.youtube.com/watch?v=zFXscjUoDDA", "video_id": "zFXscjUoDDA", "yoinked_at": "2026-05-14T23:27:02"}
