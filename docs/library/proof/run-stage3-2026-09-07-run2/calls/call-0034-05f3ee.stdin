{"card_hash": "79d110d2758584011760f8e0d6cb03d64daea298faf2fb00d48acbe7282487fc", "channel": "Mahax", "chars": 54479, "chars_all_clips": 54479, "chars_chosen_clips": 1440, "clip_count": 38, "clips": [{"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=0", "end": 119.909, "evidence_kind": "timed_clip", "excerpt_id": "fb42e45f2d85d5ec1ca64d0dddc6c8e495c955f69e59a8ef4714e939fd7396fe", "start": 0.24, "text": "So I'm delighted to be here. And, you know what's happening in AI? I don't if you've noticed but it is a thing these days and we have many people at Google working on this area so presenting the work of not just my works but many other peop", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=716", "end": 833.2, "evidence_kind": "timed_clip", "excerpt_id": "b9094fd4bcb66d1924767153f1403e5148a5489e7b4cd472e9008d3bf6f7e44b", "start": 716.19, "text": "Computer Vision Speech Recognition Language Were Starting To Both Get Excited But Also Worried About How We Would Actually Deploy These Much Better Models So This Is Kind Of The Origin How We Started To Create Our Own Tenser Processing Unit", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=1547", "end": 1666.42, "evidence_kind": "timed_clip", "excerpt_id": "68ea25b06a17d0381c1b6bfb925a2f55e671d26d34daf1bca6cd0db0bb730e37", "start": 1547.359, "text": "Things And Then Be Able To Automatically Learn Not Just Those Experts But Also Learn The Routing Mechanism To Learn Which Pieces Of Model Actually Activate For Different Examples So It Gives The Model Much Larger Capacity But Still Keeps Th", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=2263", "end": 2382.86, "evidence_kind": "timed_clip", "excerpt_id": "c95a7b27eed75d2f84906dc37675acad969263f36ffa4d59e060f7488f234a54", "start": 2263.469, "text": "Last You Know Four Or Five Years I Would Say Reinforcement Learning Has Become Much More Important In Eliciting The Desired Properties These Models Have So Given A Pre-trained Model Where You Just Exposed It To A Whole Bunch Of Training Dat", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=3562", "end": 3681.329, "evidence_kind": "timed_clip", "excerpt_id": "5f0fc8bbc6b97499342cb4a17d10f72b434bd0c949ad0aee496e156339a17572", "start": 3562.05, "text": "Development In Terms Both Pre-Training And Post Training NRL Things Like That We Have Version Of Gemini On Device On Pixel Phones That Has Somewhat Different Characteristics And Somewhat Different Aspects Of Training Data And Capabilities N", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=3800", "end": 3919.88, "evidence_kind": "timed_clip", "excerpt_id": "d0efd4fa9f598d4c0c12753f644dd4d42cb4b53ed4b1133622075ebfa897338e", "start": 3800.0, "text": "Think One Million Tokens Of Context Is Quite Useful That Gives You 1,000 Pages Or Hours Of Video Whatever But It Seems Like Even More Usefull To Be Able To Attend Trillion Tokens Of Stuff Rather Than 1,000 Million And So I Think Hybrid Syst", "timing": "source_cues", "truncated": true}], "current_topic": "AI and ML", "evidence_kind": "timed_clip", "excerpts": [{"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=0", "end": 119.909, "evidence_kind": "timed_clip", "excerpt_id": "fb42e45f2d85d5ec1ca64d0dddc6c8e495c955f69e59a8ef4714e939fd7396fe", "start": 0.24, "text": "So I'm delighted to be here. And, you know what's happening in AI? I don't if you've noticed but it is a thing these days and we have many people at Google working on this area so presenting the work of not just my works but many other peop", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=716", "end": 833.2, "evidence_kind": "timed_clip", "excerpt_id": "b9094fd4bcb66d1924767153f1403e5148a5489e7b4cd472e9008d3bf6f7e44b", "start": 716.19, "text": "Computer Vision Speech Recognition Language Were Starting To Both Get Excited But Also Worried About How We Would Actually Deploy These Much Better Models So This Is Kind Of The Origin How We Started To Create Our Own Tenser Processing Unit", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=1547", "end": 1666.42, "evidence_kind": "timed_clip", "excerpt_id": "68ea25b06a17d0381c1b6bfb925a2f55e671d26d34daf1bca6cd0db0bb730e37", "start": 1547.359, "text": "Things And Then Be Able To Automatically Learn Not Just Those Experts But Also Learn The Routing Mechanism To Learn Which Pieces Of Model Actually Activate For Different Examples So It Gives The Model Much Larger Capacity But Still Keeps Th", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=2263", "end": 2382.86, "evidence_kind": "timed_clip", "excerpt_id": "c95a7b27eed75d2f84906dc37675acad969263f36ffa4d59e060f7488f234a54", "start": 2263.469, "text": "Last You Know Four Or Five Years I Would Say Reinforcement Learning Has Become Much More Important In Eliciting The Desired Properties These Models Have So Given A Pre-trained Model Where You Just Exposed It To A Whole Bunch Of Training Dat", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=3562", "end": 3681.329, "evidence_kind": "timed_clip", "excerpt_id": "5f0fc8bbc6b97499342cb4a17d10f72b434bd0c949ad0aee496e156339a17572", "start": 3562.05, "text": "Development In Terms Both Pre-Training And Post Training NRL Things Like That We Have Version Of Gemini On Device On Pixel Phones That Has Somewhat Different Characteristics And Somewhat Different Aspects Of Training Data And Capabilities N", "timing": "source_cues", "truncated": true}, {"deep_link": "https://x.com/Mahaximus_/status/2088693280674291785#t=3800", "end": 3919.88, "evidence_kind": "timed_clip", "excerpt_id": "d0efd4fa9f598d4c0c12753f644dd4d42cb4b53ed4b1133622075ebfa897338e", "start": 3800.0, "text": "Think One Million Tokens Of Context Is Quite Useful That Gives You 1,000 Pages Or Hours Of Video Whatever But It Seems Like Even More Usefull To Be Able To Attend Trillion Tokens Of Stuff Rather Than 1,000 Million And So I Think Hybrid Syst", "timing": "source_cues", "truncated": true}], "hint": null, "platform": "x", "profile": "librarian", "schema_version": 1, "selection_version": "spread-longest-v1", "slug": "Mahax_-_Ex-Google_Jeff_Dean_just_dropped_a_1-hour_lecture_on_full_AI_engineer", "source_revision": "729d19f3269d602a83facf837d19a6b421f052771d0da8dfd37eda2dfe0dcc69", "source_type": "x_thread", "status": "evidenced", "summary_hint": null, "title": "Mahax - Ex-Google Jeff Dean just dropped a 1-hour lecture on full AI engineer...", "topic": "AI and ML", "truncated": true, "truncation": {"byte_budget": true, "fields": ["hint"], "selection": true}, "url": "https://x.com/Mahaximus_/status/2088693280674291785", "video_id": "2088677333066465280", "yoinked_at": "2026-08-16T07:35:47"}
