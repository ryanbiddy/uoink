ubject", "AI accelerator or chip competition and its implications for chip and model companies"], "name": "AI Industry and Business", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "AI Industry and Business"], "retired": false, "shelf_id": "ai-industry-and-business"}, {"definition": "Software engineering tooling as the subject: agent harnesses, IDE extensions, coding assistants, SDKs, and developer-focused workflows, described as products, capabilities, comparisons or workflows rather than taught.", "exclude": ["a tutorial, workshop or lecture whose purpose is to teach, even when it uses a developer tool -\u003e AI and ML / Education", "personal assistant or agent acting for a non-engineer user (speech, screen or task help) -\u003e AI and ML / AI Agents and Automation", "generic model comparison or model task-fit talk with no coding task, SDK or IDE -\u003e AI and ML", "consumer conversational chatbots", "pure theoretical ML papers without tools", "non-technical end-user products"], "include": ["coding assistants", "agent harnesses", "developer workflows", "software development SDKs", "IDE integrations", "code generation"], "name": "Developer Tools", "parent_shelf_id": "ai-and-ml", "path": ["AI and ML", "Developer Tools"], "retired": false, "shelf_id": "developer-tools"}, {"definition": "Lectures, pedagogical explanations, conceptual deep dives, tutorials, workshops and step-by-step walkthroughs whose purpose is to teach machine learning or how to build with AI, even when they use or name a specific tool, model or product.", "exclude": ["product announcements and release notes for a tool or model, with no teaching purpose -\u003e AI and ML / Developer Tools or AI and ML / Frontier Models", "marketing keynotes", "opinion pieces without pedagogical content"], "include": ["introductory lectures", "algorithm explanations", "machine learning coursework", "mathematical foundations", "step-by-step technical tutorials", "hands-on tutorial, workshop or walkthrough tha