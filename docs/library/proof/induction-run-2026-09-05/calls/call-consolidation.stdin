ion.", "source_revision": "31523d5a855c2b662281bf3619ba6e6e0b42e5bf87befd619421fe4d44ad9dc1", "video_id": "2090523526595854336"}}, "c143-2": {"card_key": "c143", "kind": "disposition", "support": {"card_hash": "7c474a779e79d611cf69d00f13b04ccc22e6fc948ea1501de94124e69417370a", "excerpt_id": "4b6dbad9505dc2a913a08eb69a343e4dc2b50f130a50cc01172a6655e26b95f4", "quote": "They want to know they own the means of production.", "source_revision": "31523d5a855c2b662281bf3619ba6e6e0b42e5bf87befd619421fe4d44ad9dc1", "video_id": "2090523526595854336"}}, "c144-1": {"card_key": "c144", "kind": "candidate", "support": {"card_hash": "8d7e37128c22a259783a570a5832460bcd6f6bc2c0d207e75a8bdb2a01f9c165", "excerpt_id": "1bbf3c8eab7424acc97fa6676c345d0c25760aad2cfbcfb03a9d15d7c47affc6", "quote": "OpenAI and Anthropic finally have real competition.", "source_revision": "841b95db57cd50946693bbf8d2bdcb895e3b7718232e36051669017992674a15", "video_id": "2090544926706876416"}}, "c144-2": {"card_key": "c144", "kind": "disposition", "support": {"card_hash": "8d7e37128c22a259783a570a5832460bcd6f6bc2c0d207e75a8bdb2a01f9c165", "excerpt_id": "1bbf3c8eab7424acc97fa6676c345d0c25760aad2cfbcfb03a9d15d7c47affc6", "quote": "OpenAI and Anthropic finally have real competition.", "source_revision": "841b95db57cd50946693bbf8d2bdcb895e3b7718232e36051669017992674a15", "video_id": "2090544926706876416"}}, "c145-1": {"card_key": "c145", "kind": "disposition", "support": {"card_hash": "ddc5958e89a8786e1606c773aa9006515747bc3f94aeabf90db32fbd26bbee70", "excerpt_id": "c57b4e6c80e29387245c7ca5ea5e23b5c3c30e3f318d025f46e9b149cf082d17", "quote": "you know a humanoid robot is going to have the same kind of capability as a human", "source_revision": "5f9970e48b78b1e80203b422f6b51dae899d0a5de390deda299f8f316cee1d10", "video_id": "2090566181854048256"}}, "c151-1": {"card_key": "c151", "kind": "candidate", "support": {"card_hash": "2e3451c897947a67f1d0f8a86573612fe2306524d184dead129028dbba97bf02", "excerpt_id": "a5e80a8a7c9d3