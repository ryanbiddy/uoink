[{"candidates": [{"definition": "A shelf for breaking-news style clips, crime reporting, political/cultural commentary, and military conflict footage about real-world civic events that the user has saved from social media.", "exclude": ["AI/ML product, model, or agent discussion (belongs to AI and ML / Frontier Models)", "sports highlights or streamer drama without political/civic content (belongs to Sports and Streaming Culture)", "space exploration or scientific research content (belongs to Space and Science)"], "include": ["political/cultural commentary panels debating current social or ideological issues", "local crime reporting delivered with news-anchor style narration", "historical political event footage such as law-enforcement radio traffic from a riot or breach", "war/military conflict footage showing strikes, bases, or soldiers"], "path": ["News and Current Events"], "sibling_cues": [{"confusing_alternative": "Sports and Streaming Culture (channel banter can sound like commentary)", "evidence_needed": "excerpt discusses political/social ideology (e.g. 'left', 'right', 'woke') rather than a game or match", "include_cue": "political/cultural commentary panels"}, {"confusing_alternative": "AI and ML (autonomous/safety framing could be confused with crime prevention tech)", "evidence_needed": "excerpt names an arrest, charge, or human victim with no AI/model terminology", "include_cue": "local crime reporting with anchor narration"}, {"confusing_alternative": "Sports and Streaming Culture live commentary", "evidence_needed": "excerpt uses law-enforcement/riot terms ('breach', 'riot warning') rather than game terms", "include_cue": "historical political event footage (Capitol breach radio)"}, {"confusing_alternative": "Space and Science (military hardware could be mistaken for aerospace)", "evidence_needed": "excerpt names a strike on a base or soldiers, not orbital or launch activity", "include_cue": "war/military conflict footage"}], "supporting_evidence": [