ckagetype":"bdist_wheel","python_version":"cp314","requires_python":null,"size":1771986,"upload_time":"2026-03-23T18:13:22","upload_time_iso_8601":"2026-03-23T18:13:22.153720Z","url":"https://files.pythonhosted.org/packages/6d/89/c293d818f9f899db93bf291b42401c05ae29acfb2e53d5341c30ea703e62/torchaudio-2.11.0-cp314-cp314t-manylinux_2_28_x86_64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"1ac77b6a77750febc5fe4921ac29d43b3cebf5b191d03c0e1413cab7e343ac31"},"digests":{"blake2b_256":"93f7ee5da8c03f1a3c7662c6c6a119f24a4b3e646da94be56dce3201e3a6ee9b","md5":"c143b4f965958118a15f327271bd38c2","sha256":"88fb5e29f670a33d9bac6aabb1d2734460cf6e461bde5cdc352826035851b16d"},"downloads":-1,"filename":"torchaudio-2.11.0-cp314-cp314t-win_amd64.whl","has_sig":false,"md5_digest":"c143b4f965958118a15f327271bd38c2","packagetype":"bdist_wheel","python_version":"cp314","requires_python":null,"size":328661,"upload_time":"2026-03-23T18:13:20","upload_time_iso_8601":"2026-03-23T18:13:20.100141Z","url":"https://files.pythonhosted.org/packages/93/f7/ee5da8c03f1a3c7662c6c6a119f24a4b3e646da94be56dce3201e3a6ee9b/torchaudio-2.11.0-cp314-cp314t-win_amd64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"1ac77b6a77750febc5fe4921ac29d43b3cebf5b191d03c0e1413cab7e343ac31"},"digests":{"blake2b_256":"836fb0efb44e0bfe8dd4d78d76ae3be280354e1fb5c8631c782785d74cd8a7b1","md5":"3e550f771b865462f04ae2f12003ab49","sha256":"1424638adb8bb40087bc7b6eb103e8e4fe398210f09076f33b7b5e61501b5d66"},"downloads":-1,"filename":"torchaudio-2.11.0-cp314-cp314-win_amd64.whl","has_sig":false,"md5_digest":"3e550f771b865462f04ae2f12003ab49","packagetype":"bdist_wheel","python_version":"cp314","requires_python":null,"size":328662,"upload_time":"2026-03-23T18:13:32","upload_time_iso_8601":"2026-03-23T18:13:32.243901Z","url":"https://files.pythonhosted.org/packages/83/6f/b0efb44e0bfe8dd4d78d76ae3be280354e1fb5c8631c782785d74cd8a7b1/torchaudio-2.11.0-cp31