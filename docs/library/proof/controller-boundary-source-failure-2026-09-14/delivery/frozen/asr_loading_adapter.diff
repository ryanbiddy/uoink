+def _classify_controller_attempt(profile, permit):
+    """Classify a candidate start as a controller attempt or non-controller.
+
+    Classification is a refusal rule, not new authority. Identify a controller attempt
+    through the canonical exact _ControllerASRStart and its existing issued custody,
+    including the retained permit/record relation. Check existing custody for that
+    permit/record as well as the candidate object: replacing the profile with a
+    dictionary, foreign type or copied startup must not hide an already issued controller
+    attempt. Refuse ambiguous, stale or mismatched custody. Exact controller instances
+    without issuance, and subclasses/foreign controller instances offered against that
+    controller permit, must refuse before create.
+    """
+    profile_type = type(profile)
+    is_exact_controller = profile_type is _ControllerASRStart
+    is_foreign_or_subclass = (
+        not is_exact_controller
+        and (isinstance(profile, _ControllerASRStart) or profile_type.__name__ == "_ControllerASRStart")
+    )
+    if is_foreign_or_subclass:
+        raise AdapterUnavailable("Controller subclasses and foreign controller instances are refused")
+
+    object_custody = _CONTROLLER_STARTUPS.get(id(profile)) if is_exact_controller else None
+
+    record = getattr(permit, "record", None)
+    permit_custodies = [
+        c for c in _CONTROLLER_STARTUP_ATTEMPTS.values()
+        if c.permit is permit or (record is not None and c.record is record)
+    ]
+
+    if not is_exact_controller and not permit_custodies:
+        return False
+
+    if len(permit_custodies) > 1:
+        raise AdapterUnavailable("Ambiguous controller startup custody")
+
+    permit_custody = permit_custodies[0] if permit_custodies else None
+
+    if is_exact_controller:
+        _require(type(object_custody) is _StartupCustody and object_custody.startup is profile,
+                 "Exact controller instance without issuance is refused")
+        _require(permit_custody is object_custody,
+                 "Candidate controller startup does not match permit custody")
+        _require(object_custody.permit is permit and object_custody.record is record,
+                 "Mismatched controller permit custody")
+        _require(object_custody.active, "Stale controller startup custody is refused")
+        return True
+
+    if permit_custody is not None:
+        raise AdapterUnavailable("Replaced profile against issued controller permit is refused")
+
+    return False
