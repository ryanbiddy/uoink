diff --git a/test/gemini-command-provenance.test.mjs b/test/gemini-command-provenance.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ba0e04a1a5a14aa8120b0f3d45749c46a13988ee
--- /dev/null
+++ b/test/gemini-command-provenance.test.mjs
@@ -0,0 +1,141 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { GeminiAdapter } from '../src/agents/gemini.ts';
+
+const success = { event: 'result', result: { status: 'SUCCESS', response: 'Worker finished.', conversation_id: 'fixture-session' } };
+const noticeMessage = 'Possible command truncation: Antigravity supplied a command preview; full command coverage is unverified.';
+
+// Same injected transport contract as unchanged gemini-completion.test.mjs.
+async function replay(records, stderr = [], exitCode = 0, signal) {
+  const events = [];
+  let called = 0;
+  const adapter = new GeminiAdapter('fixture-model', async (input) => {
+    called += 1;
+    for (const record of records) await input.onStdoutLine(JSON.stringify(record));
+    for (const line of stderr) await input.onStderrLine(line);
+    return { exitCode, stdout: records.map(JSON.stringify).join('\n'), stderr: stderr.join('\n') };
+  });
+  try {
+    const result = await adapter.run({ mode: 'work', model: 'fixture-model', effort: 'high',
+      cwd: process.cwd(), prompt: 'Fixture only; no provider invocation.', signal,
+      onEvent: async (event) => events.push(event) });
+    return { result, events };
+  } finally {
+    assert.equal(called, 1, 'Only the injected transport may be used');
+  }
+}
+
+function tool(parameters, state = 'ACTIVE', stepIndex = 120, toolName = 'run_command') {
+  return { event: 'step_update', step_update: {
+    conversation_id: 'fixture-conversation', step_index: stepIndex, state,
+    step_type: 'tool', tool_name: toolName,
+    tool_info: { name: toolName, parameters, output: state === 'DONE' ? 'fixture output' : '' },
+  } };
+}
+const tools = events => events.filter(event => event.type === 'tool');
+const notices = events => events.filter(event => event.payload?.kind === 'command_audit');
+function exactTools(events, records) {
+  const actual = tools(events);
+  assert.equal(actual.length, records.length);
+  for (let i = 0; i < records.length; i += 1) {
+    assert.equal(actual[i].message, records[i].step_update.tool_name);
+    assert.deepEqual(actual[i].payload, records[i]);
+    assert.equal(JSON.stringify(actual[i].payload), JSON.stringify(records[i]));
+    assert.equal(Object.hasOwn(actual[i].payload, 'command_audit'), false);
+  }
+}
+function noCompletenessClaim(events) {
+  for (const event of events) {
+    assert.notEqual(event.payload?.fullCommandAttested, true);
+    assert.notEqual(event.payload?.complete, true);
+  }
+}
+
+describe('Gemini command provenance', () => {
+  it('preserves ACTIVE and DONE records and follows each with a suspected-preview notice', async () => {
+    const command = 'x'.repeat(512) + '…';
+    const records = [tool({ CommandLine: command }), tool({ CommandLine: command }, 'DONE')];
+    const snapshot = JSON.stringify(records);
+    const { result, events } = await replay([...records, success]);
+    assert.deepEqual(result, { output: 'Worker finished.', sessionId: 'fixture-session' });
+    assert.equal(JSON.stringify(records), snapshot);
+    exactTools(events, records);
+    assert.equal(notices(events).length, 2);
+    for (const [i, state] of ['ACTIVE', 'DONE'].entries()) {
+      const originalEvent = tools(events)[i];
+      const notice = events[events.indexOf(originalEvent) + 1];
+      assert.deepEqual(notice, { type: 'status', message: noticeMessage, payload: {
+        kind: 'command_audit', provider: 'antigravity', stepIndex: 120, state,
+        parameter: 'CommandLine', suppliedUtf16Length: 513, suspectedTruncation: true,
+        fullCommandAttested: false, basis: '512_code_units_plus_terminal_ellipsis',
+      } });
+    }
+    noCompletenessClaim(events);
+  });
+
+  it('preserves a supplied long command without shortening it or certifying completeness', async () => {
+    const records = [tool({ CommandLine: 'literal-fixture-command '.repeat(300), extra: { retained: true } })];
+    const { events } = await replay([...records, success]);
+    exactTools(events, records);
+    assert.ok(tools(events)[0].payload.step_update.tool_info.parameters.CommandLine.length > 4000);
+    assert.deepEqual(notices(events), []);
+    noCompletenessClaim(events);
+  });
+
+  it('handles absent and non-string command parameters without inventing audit evidence', async () => {
+    const records = [
+      tool(undefined), tool(null), tool([]), tool('not-a-parameter-object'), tool({}),
+      tool({ CommandLine: null }), tool({ CommandLine: 513 }),
+      tool({ CommandLine: { text: 'x'.repeat(512) + '…' } }),
+    ];
+    delete records[0].step_update.tool_info;
+    const serializedRecords = records.map(record => JSON.parse(JSON.stringify(record)));
+    const { events } = await replay([...records, success]);
+    exactTools(events, serializedRecords);
+    assert.deepEqual(notices(events), []);
+    noCompletenessClaim(events);
+  });
+
+  it('does not label a short literal ellipsis or adjacent nonmatching lengths complete', async () => {
+    const records = ['echo …', 'x'.repeat(511) + '…', 'x'.repeat(513), 'x'.repeat(513) + '…']
+      .map(command => tool({ CommandLine: command }));
+    const { events } = await replay([...records, success]);
+    exactTools(events, records);
+    assert.deepEqual(notices(events), []);
+    noCompletenessClaim(events);
+  });
+
+  it('bounds notice metadata and limits the heuristic to run_command', async () => {
+    const command = 'x'.repeat(512) + '…';
+    const records = [tool({ CommandLine: command }, 'untrusted-state-canary', 'untrusted-index-canary'),
+      tool({ CommandLine: command }, 'ACTIVE', 7, 'view_file')];
+    const { events } = await replay([...records, success]);
+    exactTools(events, records);
+    const audit = notices(events);
+    assert.equal(audit.length, 1);
+    assert.equal(audit[0].payload.state, 'unknown');
+    assert.equal(audit[0].payload.stepIndex, null);
+    assert.equal(audit[0].message, noticeMessage);
+    assert.doesNotMatch(JSON.stringify(audit), /untrusted-state-canary|untrusted-index-canary/);
+    noCompletenessClaim(events);
+  });
+
+  it('preserves provider redaction while copying no synthetic secret or command into the notice', async () => {
+    const redactedPrefix = 'API_KEY=[REDACTED_TEST_SECRET] fixture-command ';
+    const command = redactedPrefix.padEnd(512, 'x') + '…';
+    const records = [tool({ CommandLine: command, privateExtra: 'SYNTHETIC_SECRET_DO_NOT_COPY' })];
+    const { events } = await replay([...records, success]);
+    exactTools(events, records);
+    const audit = notices(events);
+    assert.equal(audit.length, 1);
+    assert.equal(audit[0].message, noticeMessage);
+    assert.deepEqual(Object.keys(audit[0].payload).sort(), [
+      'basis', 'fullCommandAttested', 'kind', 'parameter', 'provider', 'state',
+      'stepIndex', 'suppliedUtf16Length', 'suspectedTruncation',
+    ].sort());
+    assert.doesNotMatch(JSON.stringify(audit), /REDACTED_TEST_SECRET|SYNTHETIC_SECRET_DO_NOT_COPY|fixture-command/);
+    assert.equal(JSON.stringify(audit).includes(command), false);
+    assert.equal(tools(events)[0].payload.step_update.tool_info.parameters.CommandLine, command);
+    noCompletenessClaim(events);
+  });
+});
