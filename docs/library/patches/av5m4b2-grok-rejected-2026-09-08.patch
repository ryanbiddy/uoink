+# sqlite3_txn_state: NONE=0, READ=1, WRITE=2. A third-connection BEGIN
+# IMMEDIATE failure cannot prove which connection owns the reserved lock.
+_SQLITE_TXN_NONE = 0
+_SQLITE_TXN_READ = 1
+_SQLITE_TXN_WRITE = 2
+_SQLITE_CAPI = None
+_SQLITE_CAPI_UNAVAILABLE = False
+
+
+def _sqlite_capi():
+    """The sqlite3.dll/_sqlite3 is linked against. None if it cannot be loaded."""
+    global _SQLITE_CAPI, _SQLITE_CAPI_UNAVAILABLE
+    if _SQLITE_CAPI is not None or _SQLITE_CAPI_UNAVAILABLE:
+        return _SQLITE_CAPI
+    try:
+        import _sqlite3
+        from ctypes import CDLL, c_char_p, c_int, c_void_p
+        pyd = Path(getattr(_sqlite3, "__file__", "") or "")
+        candidates = []
+        if pyd:
+            candidates.append(pyd.with_name("sqlite3.dll"))
+        candidates.append(Path(sys.base_prefix) / "DLLs" / "sqlite3.dll")
+        lib = None
+        if os.name == "nt":
+            for path in candidates:
+                if path.is_file():
+                    lib = CDLL(str(path))
+                    break
+        if lib is None:
+            lib = CDLL("libsqlite3.so.0" if os.name != "nt" else "sqlite3.dll")
+        lib.sqlite3_txn_state.argtypes = [c_void_p, c_char_p]
+        lib.sqlite3_txn_state.restype = c_int
+        lib.sqlite3_get_autocommit.argtypes = [c_void_p]
+        lib.sqlite3_get_autocommit.restype = c_int
+        _SQLITE_CAPI = lib
+        return lib
+    except Exception:
+        _SQLITE_CAPI_UNAVAILABLE = True
+        return None
+
+
+def _sqlite_db_pointer(conn):
+    """CPython sqlite3.Connection: sqlite3* is the first field after PyObject_HEAD."""
+    from ctypes import c_void_p
+
+    class _Head(ctypes.Structure):
+        _fields_ = [("slots", c_void_p * 4)]
+
+    try:
+        return _Head.from_address(id(conn)).slots[2]
+    except Exception:
+        return None
+
+
+def _sqlite_connection_txn_state(conn) -> int | None:
+    """Proven sqlite3_txn_state for main, or None if it cannot be proven."""
+    lib = _sqlite_capi()
+    if lib is None or conn is None:
+        return None
+    db = _sqlite_db_pointer(conn)
+    if not db:
+        return None
+    try:
+        autocommit = int(lib.sqlite3_get_autocommit(db))
+        state = int(lib.sqlite3_txn_state(db, b"main"))
+    except Exception:
+        return None
+    in_txn = bool(getattr(conn, "in_transaction", False))
+    if in_txn and autocommit != 0:
+        return None
+    if (not in_txn) and autocommit != 1:
+        return None
+    if state not in (_SQLITE_TXN_NONE, _SQLITE_TXN_READ, _SQLITE_TXN_WRITE):
+        return None
+    return state
+
+
+def _sqlite_connection_holds_write_lock(conn) -> bool:
+    """True only when this connection itself holds a write transaction."""
+    return _sqlite_connection_txn_state(conn) == _SQLITE_TXN_WRITE
+
+
