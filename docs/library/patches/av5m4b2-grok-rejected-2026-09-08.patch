+def _freeze_session(session) -> None:
+    """Suspend the real worker and pin RPC so a warm combined run cannot publish."""
+    assert session is not None and session.alive
+    _suspend_pid(session.pid)
+
+    def hung(_req):
+        until = time.monotonic() + 30
+        while session.alive and time.monotonic() < until:
+            time.sleep(0.02)
+        raise OSError("vault io worker is not running")
+
+    session.call = hung
+
+
+def _suspend_pid(pid: int) -> bool:
+    if not isinstance(pid, int) or pid <= 0:
+        return False
+    if os.name != "nt":
+        os.kill(pid, signal.SIGSTOP)
+        return True
+    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    ntdll = ctypes.WinDLL("ntdll")
+    k32.OpenProcess.restype = ctypes.c_void_p
+    k32.OpenProcess.argtypes = [ctypes.c_uint32, ctypes.c_int, ctypes.c_uint32]
+    k32.CloseHandle.argtypes = [ctypes.c_void_p]
+    ntdll.NtSuspendProcess.restype = ctypes.c_long
+    ntdll.NtSuspendProcess.argtypes = [ctypes.c_void_p]
+    handle = k32.OpenProcess(0x001F0FFF, False, int(pid))
+    if not handle:
+        return False
+    try:
+        return int(ntdll.NtSuspendProcess(handle)) == 0
+    finally:
+        k32.CloseHandle(handle)
+
