+        "source_type": "page",
+        "platform": "web",
+        "timing": None,
+        "fixture_version": LEGACY_FIXTURE_VERSION,
+    }, indent=2) + "\n", encoding="utf-8")
+    index = profile / "index.db"
+    conn = sqlite3.connect(str(index))
