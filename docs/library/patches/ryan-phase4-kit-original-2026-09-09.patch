+        return
+    body = {"jsonrpc": "2.0", "id": req["id"]}
+    if error is not None:
+        body["error"] = error
+    else:
+        body["result"] = result
+    sys.stdout.buffer.write((json.dumps(body, ensure_ascii=False) + "\n").encode("utf-8"))
+    sys.stdout.buffer.flush()
