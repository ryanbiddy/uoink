+"""scripts/measure_phase5_az5g.py - AZ-5g measured refresh runner.
+
+Executes the Phase 5 synthetic cost fixture without editing production code or tests,
+captures raw reader and actual stdio adapter observations, and writes machine-readable
+proof to docs/library/proof/phase5-az5g-measurements-2026-09-08.json.
+
+Can be executed as:
+    python -B scripts/measure_phase5_az5g.py
+or:
+    python -B -m pytest -q -s -p no:cacheprovider scripts/measure_phase5_az5g.py
+"""
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import os
+import pathlib
+import sys
+import tempfile
+import time
+from unittest.mock import patch
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+import library_analysis
+import library_resources
+import uoink_mcp
+from mcp import types as mcp_types
+from tests import test_library_analysis_fixtures as az
+
+
+def run_az5g_measurements():
+    """Run full synthetic cost fixture with compatible reader and adapter measurement."""
+    library_analysis.reset_rate_limiter()
+    real_read = library_analysis.get_library_activity
+    records = []
+
+    def measured_read(args, **kwargs):
+        conn = kwargs.get("db")
+        record = {}
+        if conn:
+            record["items"] = conn.execute("SELECT COUNT(*) FROM yoinks").fetchone()[0]
+            record["memberships"] = conn.execute("SELECT COUNT(*) FROM item_shelves").fetchone()[0]
+            record["observations"] = conn.execute("SELECT COUNT(*) FROM source_items").fetchone()[0]
+            record["applies"] = conn.execute("SELECT COUNT(*) FROM library_applies").fetchone()[0]
+            record["journal_bytes"] = conn.execute(
+                "SELECT COALESCE(SUM(LENGTH(CAST(forward_json AS BLOB))+LENGTH(CAST(inverse_json AS BLOB))), 0) FROM library_applies"
+            ).fetchone()[0]
+        record["interval"] = copy.deepcopy(args.get("interval"))
+        record["date_basis"] = args.get("date_basis")
+
+        t0 = time.perf_counter()
+        packet = real_read(args, **kwargs)
+        t1 = time.perf_counter()
+
+        record["construction_ms"] = (t1 - t0) * 1000.0
+        record["ok"] = packet.get("ok", False)
+        record["raw_bytes"] = len(json.dumps(packet, ensure_ascii=False).encode("utf-8"))
+
+        if packet.get("ok"):
+            cov = packet.get("coverage", {}).get("cov_shelf_activity", {})
+            record["baseline"] = {
+                "coverage_status": cov.get("coverage_status"),
+                "reasons": cov.get("reasons", []),
+                "clock": cov.get("clock"),
+                "earliest_retained_timestamp": cov.get("earliest_retained_timestamp"),
+                "latest_retained_timestamp": cov.get("latest_retained_timestamp"),
+            }
+            record["rows"] = {
+                "events": len(packet.get("events", {}).get("rows", [])),
+                "creators": len(packet.get("items", {}).get("by_creator_hint", [])),
+                "joint": len(packet.get("items", {}).get("by_type_creator_hint", [])),
+                "sources": len(packet.get("sources", {}).get("details", [])),
+                "shelves": len(packet.get("shelf_activity", {}).get("shelves", [])),
+            }
+            record["totals"] = {
+                "events": packet.get("events", {}).get("total_events"),
+                "creators": len(packet.get("items", {}).get("by_creator_hint", [])),
+                "joint": len(packet.get("items", {}).get("by_type_creator_hint", [])),
+                "sources": len(packet.get("sources", {}).get("details", [])),
+                "shelves": len(packet.get("shelf_activity", {}).get("shelves", [])),
+            }
+
+            # Actual stdio adapter serialization of captured packet
+            request = mcp_types.CallToolRequest(
+                method="tools/call",
+                params=mcp_types.CallToolRequestParams(name="get_library_activity", arguments=args),
+            )
+            with patch.object(library_analysis, "get_library_activity", lambda arguments: packet):
+                t0_ad = time.perf_counter()
+                actual = asyncio.run(uoink_mcp.mcp._mcp_server.request_handlers[mcp_types.CallToolRequest](request)).root
+                wire = mcp_types.JSONRPCResponse(jsonrpc="2.0", id=1, result=actual.model_dump(mode="json", exclude_none=True))
+                wire_json = wire.model_dump_json(by_alias=True, exclude_none=True)
+                t1_ad = time.perf_counter()
+
+            record["actual_stdio_bytes"] = len(wire_json.encode("utf-8"))
+            record["actual_stdio_is_error"] = actual.isError
+            record["adapter_serialization_ms"] = (t1_ad - t0_ad) * 1000.0
+            if actual.isError:
+                record["actual_stdio_error"] = json.loads(actual.content[0].text)
+        else:
+            record["error"] = packet.get("error")
+
+        records.append(record)
+        return packet
+
+    scratch_dir = pathlib.Path("_scratch/az5g")
+    scratch_dir.mkdir(parents=True, exist_ok=True)
+    tmp_dir = pathlib.Path(tempfile.mkdtemp(dir="_scratch/az5g"))
+    try:
+        with patch.object(library_analysis, "get_library_activity", measured_read):
+            az.test_activity_cost_548_and_10000(tmp_dir)
+    finally:
+        library_analysis.reset_rate_limiter()
+
+    # Replay observation probe (verifying that projected_state is populated during execution)
+    conn_rep = az.create_fixture_db(tmp_dir, "db_rep.db")
+    az.insert_yoink(conn_rep, "v_rep_1", yoinked_at="2026-09-01T12:00:00.000Z")
+    az.insert_apply(
+        conn_rep, "app_rep", 1, 0, 1,
+        created_at="2026-09-01T10:00:00.000Z",
+        forward_delta={"items": {"v_rep_1": [az.membership_row("v_rep_1", "shelf_a")]}, "policies": {}},
+        inverse_delta={"items": {"v_rep_1": []}, "policies": {}},
+    )
+    conn_rep.commit()
+    replayed_observed = []
+    old_profile = sys.getprofile()
+
+    def observe_return(frame, event, arg):
+        if event == "return" and frame.f_code is library_analysis._execute_activity.__code__:
+            ps = frame.f_locals.get("projected_state", {})
+            replayed_observed.append(bool(ps and any(ps.values())))
+
+    try:
+        sys.setprofile(observe_return)
+        pkt_rep = library_analysis.get_library_activity(
+            {"interval": {"start": "2026-09-01T00:00:00.000Z", "end": "2026-09-02T00:00:00.000Z"}},
+            db=conn_rep,
+        )
+    finally:
+        sys.setprofile(old_profile)
+    conn_rep.close()
+
+    # Query plans
+    conn_548 = az.create_fixture_db(tmp_dir, "db_qp.db")
+    az.insert_yoink(conn_548, "vid_001", yoinked_at="2026-09-01T12:00:00.000Z")
+    az.insert_apply(conn_548, "app_001", 1, 0, 1, forward_delta={"items": {}, "policies": {}}, inverse_delta={"items": {}, "policies": {}})
+    conn_548.commit()
+    qp_q1 = conn_548.execute("EXPLAIN QUERY PLAN SELECT video_id, source_type, author, channel, platform, yoinked_at, deleted_at FROM yoinks ORDER BY video_id ASC").fetchall()
+    qp_q3 = conn_548.execute("EXPLAIN QUERY PLAN SELECT apply_id, operation_key, kind, before_revision, after_revision, operation_sequence, authoritative_record_hash, forward_json, inverse_json, undo_of, created_at FROM library_applies ORDER BY operation_sequence ASC").fetchall()
+    conn_548.close()
+
+    output = {
+        "metadata": {
+            "run": "AZ-5g",
+            "date": "2026-09-08",
+            "python_version": sys.version,
+            "platform": sys.platform,
+            "git_commit": "3d2fa9f",
+            "git_tree_hash": "c3c8e1b72d3354bdfe85b1ce881e1e765aa28ea0",
+            "scope": "Phase 5 synthetic cost fixture measurements (test_activity_cost_548_and_10000)",
+        },
+        "query_plans": {
+            "Q1": [tuple(r) for r in qp_q1],
+            "Q3": [tuple(r) for r in qp_q3],
+        },
+        "replay_probe": {
+            "replayed_state_observed": any(replayed_observed),
+            "reasons": pkt_rep.get("coverage", {}).get("cov_shelf_activity", {}).get("reasons"),
+            "coverage_status": pkt_rep.get("coverage", {}).get("cov_shelf_activity", {}).get("coverage_status"),
+        },
+        "observations": records,
+    }
+
+    out_file = ROOT / "docs" / "library" / "proof" / "phase5-az5g-measurements-2026-09-08.json"
+    out_file.parent.mkdir(parents=True, exist_ok=True)
+    out_file.write_text(json.dumps(output, indent=2), encoding="utf-8")
+    print(f"\n[AZ-5G] Wrote {len(records)} benchmark observations to {out_file}")
+    return output
+
+
+if __name__ == "__main__":
+    run_az5g_measurements()
