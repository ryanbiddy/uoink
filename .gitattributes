# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must stay LF on every platform or a macOS checkout gets a
# CRLF shebang ("bad interpreter: /usr/bin/env bash^M"). Covers build-mac.sh
# and the macOS bundle launcher (installer/mac/launcher.sh).
*.sh text eol=lf
# The extensionless root launcher is a shell script too (WSL's sh rejects a
# CR). The root cmd launcher has labels, which cmd finds reliably only in CRLF.
/uoink text eol=lf
/uoink.cmd text eol=crlf
tests/fixtures/connect_v3100/* text eol=lf
tests/fixtures/articles/*.html text eol=lf

# Integrations are copied into their own repositories and stores, and their
# checks compare bytes (the Alfred info.plist test, Prettier in ray lint).
# Keep them LF on every platform; images stay binary.
integrations/** text eol=lf
integrations/**/*.png binary

# Cross-repository contract fixtures are hashed byte-for-byte. Keep their
# materialized bytes identical on Windows, macOS, and Linux.
tests/fixtures/suite_integration_v1/*.json text eol=lf


# Byte-hashed scripts and vendored sources: no EOL conversion.
scripts/measure_phase5_az5g2.py -text
scripts/run_phase5_az5g2_union.py -text
vendor/nltk-pathsec/** -text

# The Deno entitlements plist is hash-pinned in scripts/mac/payload.json.
scripts/mac/deno.entitlements.plist text eol=lf
